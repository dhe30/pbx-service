; Built-in HTTP server: serves ARI (and /metrics from res_prometheus). LOCALHOST ONLY.
[general]
enabled = yes
bindaddr = 127.0.0.1
bindport = 8088
{# The default limit of 100 concurrent HTTP sessions was exceeded at ~600 calls per node: Asterisk
   then closes new ARI requests ("HTTP session count exceeded 100 sessions"; the app sees "fetch
   failed: other side closed") and the call fails (2026-11-25 peak). #}
sessionlimit = 1000
