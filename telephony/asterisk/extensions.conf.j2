; Dialplan: hand every call to the ARI app. All call logic lives in services/ari-app.

[general]
static=yes
writeprotect=yes

[from-edge]
; Every new call from Kamailio. Kamailio sets (and strips any forged copies of):
;   X-PBX-Src:  carrier = PSTN call to one of our DIDs (Request-URI user = the DID)
;               device  = a call placed by one of our phones (Request-URI user = what it dialed:
;                         an extension number, *98, or a PSTN number)
;   X-PBX-User: the authenticated SIP username of that phone (device calls only)
exten => _[+*#0-9]!,1,NoOp(${PJSIP_HEADER(read,X-PBX-Src)} call to ${EXTEN} from ${CALLERID(num)})
; 3rd argument: the SIP Call-ID (= the edges' Call-ID; Kamailio doesn't change it), so the ARI app's
; logs can be matched with edge captures and rtpengine records. CHANNEL(pjsip,call-id) [VERIFY]
 same => n,Stasis(pbx-app,${PJSIP_HEADER(read,X-PBX-Src)},${PJSIP_HEADER(read,X-PBX-User)},${CHANNEL(pjsip,call-id)})
; Only reached if Stasis() failed (ARI app not connected). Cause 34 = congestion -> SIP 503, so
; Kamailio fails the call over to another pbx node.
 same => n,Hangup(34)

; Runs when a channel of this context hangs up, including every call the ARI app rejects before
; answering. It must NOT set a cause: without this line the `_.` below matched `h` too, and its
; Hangup(1) overwrote the app's cause, so blocked callers (403), busy (486), no answer (480) and
; failed-before-answer (503, which makes Kamailio try another pbx node) all went out as 404
; (2026-11-18). An exact extension wins over a pattern.
exten => h,1,NoOp(hangup cause ${HANGUPCAUSE})

; Anything else (e.g. non-numeric R-URI user) is not ours.
exten => _.,1,Hangup(1)
