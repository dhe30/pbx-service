; Asterisk core settings. Written by Ansible; do not edit on the host.
[directories]
astetcdir => /etc/asterisk
astmoddir => /usr/lib/asterisk/modules
astvarlibdir => /var/lib/asterisk
astdbdir => /var/lib/asterisk
astkeydir => /var/lib/asterisk
astdatadir => /var/lib/asterisk
astagidir => /var/lib/asterisk/agi-bin
astspooldir => /var/spool/asterisk
astrundir => /run/asterisk
astlogdir => /var/log/asterisk
astsbindir => /usr/sbin

[options]
transcode_via_sln = yes
; Overload guard: refuse NEW calls (Kamailio gets 503 and tries the other pbx node) above
; asterisk_maxcalls active calls (default 80 per vCPU). No load-average limit (maxload): the 1-minute
; load average spikes to 2-3 from bursts of short-lived Asterisk threads while the CPU is half idle,
; and refused hundreds of calls an hour on 2026-11-15 (0.95, then 2 x vCPUs). Measured that day:
; ~1 % CPU per call with proxy_media bridges + ~10 % base on a 1-vCPU node, so 80 calls ~ 90 %.
maxcalls = {{ asterisk_maxcalls }}
documentation_language = en_US
