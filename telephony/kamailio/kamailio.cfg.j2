#!KAMAILIO
#
# Kamailio edge config, rendered per edge node by Ansible (role: kamailio).
# Spec: CLAUDE.md §7 + docs/spec-transition.md. Kamailio only handles SIGNALING; all audio goes
# through rtpengine.
#
# Who talks to us ("public" = the internet-facing sockets, see Listeners below):
#   carrier   -> udp public:5060    INVITEs for our DIDs                        (FLT_CARRIER)
#   pbx-N     -> udp private:{{ kamailio_internal_port }}   Asterisk ringing phones, vendor legs, in-dialog (FLT_PBX)
#   peer edge -> udp private:{{ kamailio_internal_port }}   INVITE for a phone connected there; DMQ      (FLT_PEER)
#   phones    -> udp public:5060    REGISTER / INVITE (desk phones, _sip._udp SRV)
#   phones    -> tls public:{{ kamailio_tls_port }}   REGISTER / INVITE (_sips._tcp SRV), SRTP-SDES media
#   browsers  -> ws  private:{{ kamailio_ws_port }}   via HAProxy (which terminates wss:// TLS)
#   vendors   <- udp public:5060    outgoing PSTN legs (Asterisk -> us -> vendor; digest auth by Asterisk)
#
# Call legs (Record-Route ;leg= tag, so in-dialog requests get the right rtpengine flags):
#   carrier   : carrier   <-> rtpengine <-> Asterisk   plain RTP
#   vendor    : vendor    <-> rtpengine <-> Asterisk   plain RTP
#   staff_udp : SIP phone <-> rtpengine <-> Asterisk   plain RTP
#   staff_tls : SIP phone <-> rtpengine <-> Asterisk   SRTP (SDES, RFC 4568) toward the phone
#   staff_ws  : browser   <-> rtpengine <-> Asterisk   DTLS-SRTP + ICE toward the browser
# Asterisk ALWAYS gets plain RTP with PCMU (+ telephone-event). Toward everyone else rtpengine
# offers PCMU, PCMA, G.729, G.723.1 and Opus, so a phone that supports only one of them still
# works ("A phone may support only one of PCMU, PCMA, G.729, G.723.1, or Opus"); rtpengine
# transcodes only when the far side didn't pick PCMU.

####### Defines ########

#!define FLT_CARRIER 1
#!define FLT_PBX 2
#!define FLT_PEER 3
#!define FLT_DEVICE_SRC 4
#!define FLT_TRUSTED 6

# Branch flags (per forked branch toward a phone)
#!define FLB_WS 1
#!define FLB_TLS 2

#!define DBURL_RO "{{ kamailio_db_ro_url }}"

{# ---- rtpengine flag sets (one place; every offer/answer below uses these) ---- #}
{% set BASE = "replace-origin replace-session-connection" %}
{% set TO_PBX_CODECS = "codec-mask=all codec-transcode=PCMU codec-transcode=telephone-event" %}
{% set TO_FAR_CODECS = "codec-transcode=PCMA codec-transcode=G729 codec-transcode=G723 codec-transcode=opus" %}
{# SDES offer toward TLS phones: only the AES_CM_128 suites. rtpengine accepts an answer only if
   its a=crypto suite AND tag match one it offered, and numbers its own suites from 1 in its
   internal order (AEAD/AES-256 first). A phone that answered "a=crypto:1 AES_CM_128_HMAC_SHA1_80"
   was rejected ("SRTP output wanted, but no crypto suite was negotiated") and heard nothing
   (2026-11-14, 1 of 5 TLS calls). With only these two, _80 is tag 1 and _32 tag 2. #}
{% set TLS_SDES = "SDES-only-AES_CM_128_HMAC_SHA1_80 SDES-only-AES_CM_128_HMAC_SHA1_32" %}
{% set F = {
  'plain': {
    'far_offer':   "direction=external direction=internal " ~ BASE ~ " ICE=remove RTP/AVP " ~ TO_PBX_CODECS,
    'far_answer':  BASE ~ " ICE=remove RTP/AVP",
    'pbx_offer':   "direction=internal direction=external " ~ BASE ~ " ICE=remove RTP/AVP " ~ TO_FAR_CODECS,
    'pbx_answer':  BASE ~ " ICE=remove RTP/AVP",
  },
  'tls': {
    'far_offer':   "direction=external direction=internal " ~ BASE ~ " ICE=remove DTLS=off RTP/AVP " ~ TO_PBX_CODECS,
    'far_answer':  BASE ~ " ICE=remove DTLS=off RTP/SAVP",
    'pbx_offer':   "direction=internal direction=external " ~ BASE ~ " ICE=remove DTLS=off RTP/SAVP " ~ TLS_SDES ~ " " ~ TO_FAR_CODECS,
    'pbx_answer':  BASE ~ " ICE=remove DTLS=off RTP/AVP",
  },
  'ws': {
    'far_offer':   "direction=external direction=internal " ~ BASE ~ " ICE=remove DTLS=off rtcp-mux-demux RTP/AVP " ~ TO_PBX_CODECS,
    'far_answer':  BASE ~ " ICE=force DTLS=passive SDES-off rtcp-mux-accept RTP/SAVPF",
    'pbx_offer':   "direction=internal direction=external " ~ BASE ~ " ICE=force DTLS=passive SDES-off rtcp-mux-offer generate-mid RTP/SAVPF",
    'pbx_answer':  BASE ~ " ICE=remove DTLS=off rtcp-mux-demux RTP/AVP",
  },
} %}
{# far_*: the request came from the carrier/vendor/phone side and goes to Asterisk.
   pbx_*: the request came from Asterisk and goes to the carrier/vendor/phone.
   *_offer flags go on the request's SDP, *_answer flags on the reply's SDP. #}

####### Global parameters #########

debug={{ kamailio_debug | default(2) }}
log_stderror=no
log_facility=LOG_LOCAL0
log_prefix="{$mt $hdr(CSeq) $ci} "

fork=yes
# Workers per UDP socket / for TCP+TLS+WS. Nothing on the request path blocks on the database any
# more (registrations are in memory), so these mostly absorb bursts (B1).
children={{ kamailio_children | default(16) }}
tcp_children={{ kamailio_tcp_children | default(16) }}
tcp_max_connections={{ kamailio_tcp_max_connections | default(16384) }}
tls_max_connections={{ kamailio_tcp_max_connections | default(16384) }}

# Pick the outgoing socket by routing table when the public address is its own interface.
mhomed=1
auto_aliases=no

####### Listeners #########
# SIP writes addresses INTO its messages (Via, Record-Route, Contact; rtpengine does the SDP), and
# the other side sends replies, BYE/re-INVITE and audio to them. So every socket must put the
# address its audience can reach:
#   - internal socket: the private IP, for Asterisk, the peer edge and DMQ (they can't reach the
#     public IP from inside: no hairpin, and their source would look like an outside client);
#   - public sockets: the public IP, for the carrier, vendors and phones.
# Behind 1:1 NAT (Clanode: the public IP isn't on the VM, inventory public_bind_ip = private_ip)
# both share the one local address, so they need different ports, and the public ones bind the
# local address and "advertise" the public one. Requests toward the internet force the public
# socket (route[SEND_PUBLIC]); with enable_double_rr, a request crossing from one socket to the
# other gets a Record-Route per side, and in-dialog requests go back out of the right one.
#
# The internal socket is listed FIRST: it's the default when nothing forces a socket (DMQ, the
# peer edge, dispatcher OPTIONS pings also set it explicitly).
listen=udp:{{ private_ip }}:{{ kamailio_internal_port }}
listen=udp:{{ public_bind_ip }}:5060{% if public_bind_ip != public_ip %} advertise {{ public_ip }}:5060{% endif %}

listen=tls:{{ public_bind_ip }}:{{ kamailio_tls_port }}{% if public_bind_ip != public_ip %} advertise {{ public_ip }}:{{ kamailio_tls_port }}{% endif %}

# WebSocket listener (HTTP upgrade). Only HAProxy connects here; never exposed publicly.
listen=tcp:{{ private_ip }}:{{ kamailio_ws_port }}

alias="{{ sip_domain }}"
alias="{{ public_ip }}"

enable_tls=yes

# TCP/TLS/WS connections are long-lived (phones keep them for their registration).
tcp_accept_no_cl=yes
tcp_connection_lifetime=3605
tcp_keepalive=yes

server_header="Server: pbx-edge"
user_agent_header="User-Agent: pbx-edge"

####### Modules Section ########

loadmodule "tls.so"
loadmodule "jsonrpcs.so"
loadmodule "kex.so"
loadmodule "corex.so"
loadmodule "tm.so"
loadmodule "tmx.so"
loadmodule "sl.so"
loadmodule "rr.so"
loadmodule "pv.so"
loadmodule "maxfwd.so"
loadmodule "textops.so"
loadmodule "textopsx.so"
loadmodule "siputils.so"
loadmodule "xlog.so"
loadmodule "sanity.so"
loadmodule "ctl.so"
loadmodule "db_postgres.so"
loadmodule "sqlops.so"
loadmodule "htable.so"
loadmodule "usrloc.so"
loadmodule "registrar.so"
loadmodule "path.so"
loadmodule "auth.so"
loadmodule "auth_db.so"
loadmodule "nathelper.so"
loadmodule "rtpengine.so"
loadmodule "dispatcher.so"
loadmodule "ipops.so"
loadmodule "pike.so"
loadmodule "xhttp.so"
loadmodule "websocket.so"
loadmodule "dmq.so"
loadmodule "dmq_usrloc.so"

# ----- tls (phones registering over _sips._tcp) -----
modparam("tls", "config", "/etc/kamailio/tls.cfg")

# ----- tm -----
modparam("tm", "failure_reply_mode", 3)
modparam("tm", "fr_timer", 5000)          # ms: no reply at all
modparam("tm", "fr_inv_timer", 120000)    # ms: provisional received, waiting for final

# ----- rr -----
modparam("rr", "enable_full_lr", 0)
# No ;ftag= in Record-Route: only is_direction() needs it and this config never calls it. Each
# ftag costs ~42 bytes per Record-Route (two per request), and requests to UDP phones must fit
# in one packet (2026-11-14: a 1,609-byte INVITE was fragmented and never reached a NATed phone).
modparam("rr", "append_fromtag", 0)
# Two Record-Route headers when the in/out sockets differ (public<->internal, ws<->udp), each with
# that socket's (advertised) address; loose_route() then forces the matching socket in-dialog.
modparam("rr", "enable_double_rr", 1)

# ----- database: READ-ONLY connection, auth + DID lookups only (B1) -----
# Points at the local DB proxy's "any healthy member" port (replicas preferred), so a Patroni
# failover does not stop authentication. Nothing in Kamailio writes to Postgres any more.
modparam("db_postgres", "timeout", 2)
modparam("sqlops", "sqlcon", "ro=>{{ kamailio_db_ro_url }}")

# ----- usrloc / registrar: in memory, replicated to the other edges with DMQ (B1) -----
# Phase 1 used db_mode=3: every REGISTER and every lookup was a round trip to the Patroni primary,
# and a primary failover stopped all registrations and all calls to phones.
modparam("usrloc", "db_mode", 0)
modparam("usrloc", "use_domain", 0)       # one SIP domain; sip_username is globally unique
modparam("usrloc", "timer_interval", 30)

modparam("registrar", "use_path", 1)
modparam("registrar", "path_mode", 0)     # store Path even if the client doesn't support it
modparam("registrar", "path_use_received", 0)
modparam("registrar", "default_expires", 300)
modparam("registrar", "min_expires", 60)
modparam("registrar", "max_expires", 600)
# "Any number of phones register" per extension: no cap. A reconnecting phone re-registers with the
# same Contact URI and replaces its own old binding (usrloc matching on Contact).
modparam("registrar", "max_contacts", 0)

# path: when a peer edge relays to us with our Path as Route, deliver to the "received" address
# (the phone's connection) stored in it.
modparam("path", "use_received", 1)

# ----- dmq: replicate registrations between edges -----
# Internal socket on every edge (sent from the default socket, which is the internal one).
modparam("dmq", "server_address", "sip:{{ private_ip }}:{{ kamailio_internal_port }}")
{% if edge_peer_ips | length > 0 %}
{% for ip in edge_peer_ips %}
modparam("dmq", "notification_address", "sip:{{ ip }}:{{ kamailio_internal_port }}")
{% endfor %}
{% else %}
modparam("dmq", "notification_address", "sip:{{ private_ip }}:{{ kamailio_internal_port }}")
{% endif %}
modparam("dmq", "multi_notify", 1)
modparam("dmq", "num_workers", 4)
modparam("dmq_usrloc", "enable", 1)
# On start, pull the full location table from a peer (an edge that restarts keeps every phone).
modparam("dmq_usrloc", "sync", 1)

# ----- auth -----
modparam("auth_db", "db_url", DBURL_RO)
modparam("auth_db", "calculate_ha1", yes)
modparam("auth_db", "password_column", "password")
# The extension's account comes along with the credentials: used to keep an account's calls on
# one pbx node (attended transfer needs both calls on the same Asterisk, B5).
modparam("auth_db", "load_credentials", "$avp(tenant)=tenant_id")
modparam("auth_db", "use_domain", 0)

# ----- htable: DID -> account cache (for pbx-node affinity of carrier calls) -----
modparam("htable", "htable", "didt=>size=12;autoexpire=300;")

# ----- dispatcher: set 1 = pbx (Asterisk) nodes -----
modparam("dispatcher", "list_file", "/etc/kamailio/dispatcher.list")
modparam("dispatcher", "flags", 2)                 # failover support (ds_next_dst)
modparam("dispatcher", "ds_ping_interval", 5)
modparam("dispatcher", "ds_probing_threshold", 2)
modparam("dispatcher", "ds_inactive_threshold", 2)
modparam("dispatcher", "ds_probing_mode", 1)       # always probe, so dead nodes come back automatically
modparam("dispatcher", "ds_ping_from", "sip:dispatcher@{{ private_ip }}")
modparam("dispatcher", "ds_ping_reply_codes", "class=2")
# Algorithm 7 hashes this value: the account id, so all of an account's calls land on one node.
modparam("dispatcher", "hash_pvar", "$avp(dshash)")

# ----- rtpengine: the SAME set on every edge, so any edge can handle any call's in-dialog requests.
# Node choice is a hash of the Call-ID.
modparam("rtpengine", "rtpengine_sock", "{% for ip in rtpengine_ips %}udp:{{ ip }}:2223{% if not loop.last %} {% endif %}{% endfor %}")
modparam("rtpengine", "rtpengine_disable_tout", 20)
# Wait per attempt for rtpengine's reply. Measured 2026-11-14 (10 min, 191 commands): replies take
# 0.2-6 ms (same edge < 1.5 ms, cross-edge 1-6 ms). With 1000 ms, ONE lost UDP packet held the SIP
# message for exactly 1 s (a re-INVITE's 200 OK took 1.008 s; the course's re-INVITE p95 ~1 s),
# and the cross-edge path does lose them: twice in 3 days both attempts were lost (ERROR "timeout
# waiting reply" for ping on each edge; a loss recovered by the resend isn't logged). 250 ms caps a
# single loss at 0.25 s; 3 attempts keep 750 ms of patience for an rtpengine busy transcoding.
# Resending is safe: rtpengine answers a repeated cookie from its cache without redoing the command.
modparam("rtpengine", "rtpengine_tout_ms", 250)
modparam("rtpengine", "rtpengine_retr", 3)
# Forking: each branch toward a phone gets its own media leg in rtpengine (via-branch=extra with
# a per-branch id), otherwise the branches' offers overwrite each other and the answering phone
# can end up with no audio.
modparam("rtpengine", "extra_id_pv", "$avp(extra_id)")

# ----- nathelper -----
modparam("nathelper", "natping_interval", 0)       # clients keep their own NAT bindings alive

# ----- websocket -----
modparam("websocket", "keepalive_mechanism", 1)    # send WS pings
modparam("websocket", "keepalive_timeout", 30)
modparam("websocket", "keepalive_interval", 1)

# ----- pike (light flood protection for untrusted sources; course testers exempt, B2) -----
modparam("pike", "sampling_time_unit", 2)
modparam("pike", "reqs_density_per_unit", {{ kamailio_pike_density | default(200) }})
modparam("pike", "remove_latency", 4)

# ----- control interfaces (kamcmd / kamctl) -----
modparam("ctl", "binrpc", "unix:/run/kamailio/kamailio_ctl")
modparam("jsonrpcs", "pretty_format", 1)

####### Routing Logic ########

request_route {
	route(CLASSIFY);
	route(REQINIT);

	if (is_method("KDMQ")) {
		route(DMQ);
		exit;
	}

	if (is_method("CANCEL")) {
		if (t_check_trans()) {
			rtpengine_delete();
			route(RELAY);
		}
		exit;
	}

	# Retransmissions of requests we're already handling.
	if (!is_method("ACK")) {
		if (t_precheck_trans()) {
			t_check_trans();
			exit;
		}
		t_check_trans();
	}

	route(NATDETECT);

	if (has_totag()) {
		route(WITHINDLG);
		exit;
	}

	if (is_method("REGISTER")) {
		route(REGISTRAR);
		exit;
	}

	if (is_method("INVITE")) {
		if (isflagset(FLT_PEER)) route(FROM_PEER);
		if (isflagset(FLT_CARRIER)) route(FROM_CARRIER);
		if (isflagset(FLT_PBX)) {
			if ({% for h in vendor_hosts %}$rd == "{{ h }}"{% if not loop.last %} || {% endif %}{% endfor %}) route(TO_VENDOR);
			route(TO_DEVICES);
		}
		route(FROM_DEVICE);
		exit;
	}

	if (is_method("ACK")) {
		# ACK for a non-2xx reply is absorbed by tm; anything else here is stray.
		exit;
	}

	sl_send_reply("403", "Forbidden");
	exit;
}

# Who sent this request? Sets FLT_CARRIER / FLT_PBX / FLT_PEER / FLT_DEVICE_SRC (+ FLT_TRUSTED).
route[CLASSIFY] {
{# carrier_cidrs / trusted_tester_cidrs entries: "IP", "IP/bits", optionally ":port" (carrier only).
   A port pins the carrier to one source port, so phones on the SAME machine (local testing: SIPp
   carrier on :5062, MicroSIP phone on :5060) are still treated as phones. #}
{% macro net(entry) %}{% set n = entry.split(':')[0] %}{{ n if '/' in n else n ~ '/32' }}{% endmacro %}
{% for entry in (carrier_cidrs + trusted_tester_cidrs) %}
	if (is_in_subnet("$si", "{{ net(entry) }}")) setflag(FLT_TRUSTED);
{% endfor %}
{% for entry in carrier_cidrs %}
	if (is_in_subnet("$si", "{{ net(entry) }}"){% if ':' in entry %} && $sp == {{ entry.split(':')[1] }}{% endif %} && $pr == "udp") {
		setflag(FLT_CARRIER);
		return;
	}
{% endfor %}
	# Matches source IP + port + protocol against the dispatcher list (Asterisk nodes).
	if (ds_is_from_list("1")) {
		setflag(FLT_PBX);
		return;
	}
{% for ip in edge_peer_ips %}
	if ($si == "{{ ip }}" && $pr == "udp") {
		setflag(FLT_PEER);
		return;
	}
{% endfor %}
	setflag(FLT_DEVICE_SRC);
}

route[REQINIT] {
	if (!mf_process_maxfwd_header("10")) {
		sl_send_reply("483", "Too Many Hops");
		exit;
	}
	if (!sanity_check("17895", "7")) {
		xlog("L_WARN", "malformed request from $si:$sp\n");
		exit;
	}
	if (isflagset(FLT_DEVICE_SRC) && !isflagset(FLT_TRUSTED)) {
		# Anything on the public internet gets scanned; drop the well-known scanners silently.
		if ($ua =~ "friendly-scanner|sipcli|sipvicious|sip-scan|VaxSIPUserAgent|pplsip") {
			exit;
		}
		# The course's simulated phones come from a few IPs (FLT_TRUSTED): never rate-limit them.
		if (!pike_check_req()) {
			xlog("L_ALERT", "pike blocking $rm from $si:$sp\n");
			exit;
		}
	}
	# Our internal headers (account, source) can only come from us.
	if (!isflagset(FLT_PBX) && !isflagset(FLT_PEER)) {
		remove_hf_re("^X-PBX-");
	}
	# Keepalive / dispatcher probes / Asterisk qualify addressed to us.
	if (is_method("OPTIONS") && uri == myself && $rU == $null) {
		sl_send_reply("200", "OK");
		exit;
	}
}

# Phones (UDP behind NAT, TLS, WS) put unreachable addresses in Contact; remember the real source
# with an ;alias param so in-dialog requests can find them again.
route[NATDETECT] {
	if (!isflagset(FLT_DEVICE_SRC)) return;
	force_rport();
	if (!is_method("REGISTER") && (nat_uac_test("83") || $pr == "tls")) {   # 1+2+16+64 (64 = WebSocket)
		if (!add_contact_alias()) {
			xlog("L_ERR", "cannot alias contact <$ct>\n");
			sl_send_reply("400", "Bad Request");
			exit;
		}
	}
}

route[RELAY] {
	if (!t_relay()) {
		sl_reply_error();
	}
	exit;
}

# A new request leaves toward the internet (carrier, vendor, phone): send it from the public UDP
# socket so its Via / Record-Route carry the public (advertised) address. TLS and WS have one
# socket each, which the transport already selects. In-dialog requests don't need this: the
# double Record-Route makes loose_route() pick the socket.
route[SEND_PUBLIC] {
	if ($du != $null && $du != "") {
		$var(np) = $(du{uri.transport});
	} else {
		$var(np) = $(ru{uri.transport});
	}
	if ($var(np) == $null || $var(np) == "" || $var(np) =~ "^(udp|UDP)$") {
		force_send_socket(udp:{{ public_bind_ip }}:5060);
	}
}

route[DMQ] {
	# Registration replication between edges only.
	if (!isflagset(FLT_PEER) && $si != "{{ private_ip }}") {
		sl_send_reply("403", "Forbidden");
		exit;
	}
	dmq_handle_message();
	exit;
}

# ---------------------------------------------------------------------------------------------
# REGISTER: desk phones (UDP/TLS) and browsers (WS). Any number per extension.
# ---------------------------------------------------------------------------------------------
route[REGISTRAR] {
	# Asterisk and peer edges never register. Carrier IPs may (in testing, SIPp acts as both the
	# carrier and a phone from one machine); auth below is still required.
	if (isflagset(FLT_PBX) || isflagset(FLT_PEER)) {
		sl_send_reply("403", "Forbidden");
		exit;
	}
	if (!auth_check("$fd", "subscriber", "1")) {
		auth_challenge("$fd", "1");
		exit;
	}
	consume_credentials();

	# Path = "reach this contact through THIS edge". The received param is where the client
	# actually is (for a browser: HAProxy's connection to us, which carries the WebSocket).
	# Another edge that looks this user up relays the call to us via Path; we use received.
	$var(rcv) = "sip:" + $si + ":" + $sp + ";transport=" + $pr;
	remove_hf("Path");
	append_hf("Path: <sip:{{ private_ip }}:{{ kamailio_internal_port }};lr;received=$(var(rcv){s.escape.param})>\r\n");
	# Apply the header change so registrar sees the Path we just added.
	if (!msg_apply_changes()) {
		sl_send_reply("500", "Server Error");
		exit;
	}
	if (!save("location")) {
		sl_reply_error();
	}
	exit;
}

# ---------------------------------------------------------------------------------------------
# Pick a pbx node: hash on the account so all of its calls share one Asterisk (B5); round-robin
# when the account is unknown. ds_next_dst() fails over in hash order.
# ---------------------------------------------------------------------------------------------
route[PBX_SELECT] {
	$avp(dshash) = $var(tenant);
	$var(alg) = 7;
	if ($var(tenant) == "" || $var(tenant) == $null) $var(alg) = 4;
	if (!ds_select_dst("1", "$var(alg)")) {
		xlog("L_ERR", "no pbx node available for $rU\n");
		send_reply("503", "Service Unavailable");
		exit;
	}
}

# Before relaying to a pbx node (initial try and each failover).
route[PBX_TIMERS] {
	# 2 s to get any reply from the pbx node before trying the next one; 120 s once ringing.
	t_set_fr(120000, 2000);
	t_on_reply("RTP_REPLY");
	t_on_failure("PBX_FAILOVER");
}

failure_route[PBX_FAILOVER] {
	if (t_is_canceled()) exit;
	# 503: ARI app down (dialplan Hangup(34)) or overloaded. Timeout: node dead.
	# The SDP rewritten by rtpengine_offer in request_route is kept for the new branch.
	if (t_check_status("500|503") || (t_branch_timeout() && !t_branch_replied())) {
		xlog("L_WARN", "pbx $du failed ($T_reply_code), trying next\n");
		ds_mark_dst("ip");   # inactive + probing until it answers OPTIONS again
		if (ds_next_dst()) {
			route(PBX_TIMERS);
			t_relay();
			exit;
		}
	}
	rtpengine_delete();
}

# ---------------------------------------------------------------------------------------------
# carrier -> Asterisk: a PSTN call to one of our DIDs
# ---------------------------------------------------------------------------------------------
route[FROM_CARRIER] {
	if (!($rU =~ "^\+?[0-9]{4,16}$")) {
		sl_send_reply("404", "Not Found");
		exit;
	}
	# DID -> account, cached; a DB hiccup only costs affinity (fall back to hashing the DID).
	# Failures are cached too (autoexpire), so a DB outage costs ONE timeout per DID, not one per call
	# (post-dial delay is graded).
	$var(did) = $rU;
	if ($(rU{s.substr,0,1}) == "+") $var(did) = $(rU{s.substr,1,0});
	$var(tenant) = $sht(didt=>$var(did));
	if ($var(tenant) == $null) {
		$var(tenant) = "-";
		if (sql_query("ro", "select tenant_id from public.kamailio_did_tenant where did_digits = '$var(did)' limit 1", "ra")) {
			if ($dbr(ra=>rows) > 0) $var(tenant) = $dbr(ra=>[0,0]);
			sql_result_free("ra");
		}
		$sht(didt=>$var(did)) = $var(tenant);
	}
	if ($var(tenant) == "-") $var(tenant) = $var(did);

	append_hf("X-PBX-Src: carrier\r\n");
	route(PBX_SELECT);
	add_rr_param(";leg=carrier");
	record_route();
	if (!rtpengine_offer("{{ F.plain.far_offer }}")) {
		xlog("L_ERR", "rtpengine offer failed for carrier call\n");
		send_reply("503", "Media Unavailable");
		exit;
	}
	$avp(rtp_answer) = "{{ F.plain.far_answer }}";
	route(PBX_TIMERS);
	route(RELAY);
}

# ---------------------------------------------------------------------------------------------
# phone -> Asterisk: a customer's desk phone or softphone places a call (extension, *98, PSTN)
# ---------------------------------------------------------------------------------------------
route[FROM_DEVICE] {
	if (!auth_check("$fd", "subscriber", "1")) {
		auth_challenge("$fd", "1");   # 407 for INVITE
		exit;
	}
	$var(user) = $au;
	$var(tenant) = $avp(tenant);
	consume_credentials();

	append_hf("X-PBX-Src: device\r\n");
	append_hf("X-PBX-User: $var(user)\r\n");
	route(PBX_SELECT);

	if ($pr == "ws" || $pr == "wss") {
		add_rr_param(";leg=staff_ws");
		record_route();
		rtpengine_offer("{{ F.ws.far_offer }}");
		$var(ok) = $rc;
		$avp(rtp_answer) = "{{ F.ws.far_answer }}";
	} else if ($pr == "tls") {
		add_rr_param(";leg=staff_tls");
		record_route();
		rtpengine_offer("{{ F.tls.far_offer }}");
		$var(ok) = $rc;
		$avp(rtp_answer) = "{{ F.tls.far_answer }}";
	} else {
		add_rr_param(";leg=staff_udp");
		record_route();
		rtpengine_offer("{{ F.plain.far_offer }}");
		$var(ok) = $rc;
		$avp(rtp_answer) = "{{ F.plain.far_answer }}";
	}
	if ($var(ok) < 0) {
		xlog("L_ERR", "rtpengine offer failed for call from $var(user)\n");
		send_reply("503", "Media Unavailable");
		exit;
	}
	route(PBX_TIMERS);
	route(RELAY);
}

# ---------------------------------------------------------------------------------------------
# Asterisk -> PSTN vendor (outgoing call, forwarding, simultaneous ring, transfer to a number).
# Asterisk sends it with us as outbound proxy and answers the vendor's 401/407 itself.
# ---------------------------------------------------------------------------------------------
route[TO_VENDOR] {
	if (is_present_hf("Route")) loose_route();   # our own pre-loaded Route from Asterisk
	add_rr_param(";leg=vendor");
	record_route();
	if (!rtpengine_offer("{{ F.plain.pbx_offer }}")) {
		send_reply("503", "Media Unavailable");
		exit;
	}
	$avp(rtp_answer) = "{{ F.plain.pbx_answer }}";
	t_on_reply("RTP_REPLY");
	t_on_failure("VENDOR_FAILURE");
	route(SEND_PUBLIC);
	route(RELAY);
}

failure_route[VENDOR_FAILURE] {
	if (t_is_canceled()) exit;
	# 401/407: Asterisk re-sends with credentials on the same Call-ID; keep the media session.
	if (!t_check_status("401|407")) rtpengine_delete();
}

# ---------------------------------------------------------------------------------------------
# Asterisk -> every registered device of one extension (parallel fork)
# ---------------------------------------------------------------------------------------------
route[TO_DEVICES] {
	if (!lookup("location")) {
		# No device registered: the ARI app treats it as "no answer" (forward / voicemail).
		# Fork logging (L_INFO, shown at debug=2): which extension rang which contact, and how each
		# branch ended. Needed to tell "desk phone never rang" from "desk phone lost the race".
		xlog("L_INFO", "devices: $rU has no registered contact, 480 [ci=$ci]\n");
		send_reply("480", "Temporarily Unavailable");
		exit;
	}
	# Keep the INVITE inside one UDP packet (path MTU 1,450 on the edges). Measured 2026-11-14:
	# 1,602-1,609 bytes, sent as two IP fragments, and a phone behind a NAT that drops fragments
	# (campus network) never rang, retransmissions included. Cut what a phone doesn't use (~140 B):
	#  - P-Asserted-Identity repeats From (phones and the softphone show From without it);
	#  - User-Agent;
	#  - Supported: keep 100rel, timer (session refresh), replaces (attended transfer);
	#  - Allow: keep what a phone may send in this dialog (UPDATE, PRACK, INFO DTMF, REFER and its
	#    NOTIFYs for transfer, OPTIONS); drop REGISTER, SUBSCRIBE, PUBLISH, MESSAGE.
	# Plus no ;ftag in Record-Route (rr append_fromtag 0, ~84 B).
	remove_hf("P-Asserted-Identity");
	remove_hf("User-Agent");
	if (is_present_hf("Supported")) {
		remove_hf("Supported");
		append_hf("Supported: 100rel, timer, replaces\r\n");
	}
	if (is_present_hf("Allow")) {
		remove_hf("Allow");
		append_hf("Allow: INVITE, ACK, BYE, CANCEL, OPTIONS, UPDATE, PRACK, INFO, REFER, NOTIFY\r\n");
	}
	t_on_branch("DEV_BRANCH");
	t_on_reply("DEV_REPLY");
	t_on_failure("DEV_FAILURE");
	route(RELAY);
}

# Runs once per contact. $du is that contact's Path: the edge holding its connection, with the
# phone's real address in ;received.
branch_route[DEV_BRANCH] {
	$var(rcv) = "";
	if ($du != $null && $(du{uri.param,received}) != "") {
		$var(rcv) = $(du{uri.param,received}{s.unescape.param});
	}
	$var(tp) = "udp";
	if ($var(rcv) != "") {
		$var(tp) = $(var(rcv){uri.transport});
	} else if ($(ru{uri.transport}) != "") {
		$var(tp) = $(ru{uri.transport});
	}
	if ($var(tp) =~ "^wss?$") setbflag(FLB_WS);
	else if ($var(tp) =~ "^tls$") setbflag(FLB_TLS);
	xlog("L_INFO", "devices: branch $T_branch_idx of $rU -> $ru via $du ($var(tp)) [ci=$ci]\n");

	if ($var(rcv) != "" && $(du{uri.host}) == "{{ private_ip }}") {
		# The phone is connected to THIS edge: send straight to it (drop our own Path route), from
		# the public socket.
		remove_hf("Route");
		$du = $var(rcv);
		route(SEND_PUBLIC);
	}
	# else: leave $du = peer edge; it delivers over its own connection (route FROM_PEER). That
	# goes out of the default (internal) socket.

	# Leg tag for in-dialog requests (hold/resume, transfer). They can't tell from their own
	# transport: with two edges a browser's re-INVITE reaches the anchoring edge over UDP.
	$avp(extra_id) = @via[1].branch + $T_branch_idx;
	if (isbflagset(FLB_WS)) {
		add_rr_param(";leg=staff_ws");
		record_route();
		if (!rtpengine_offer("via-branch=extra {{ F.ws.pbx_offer }}")) drop;
	} else if (isbflagset(FLB_TLS)) {
		add_rr_param(";leg=staff_tls");
		record_route();
		if (!rtpengine_offer("via-branch=extra {{ F.tls.pbx_offer }}")) drop;
	} else {
		add_rr_param(";leg=staff_udp");
		record_route();
		if (!rtpengine_offer("via-branch=extra {{ F.plain.pbx_offer }}")) drop;
	}
}

onreply_route[DEV_REPLY] {
	if ($rs >= 180) xlog("L_INFO", "devices: $rs $rr from $si for $tU [ci=$ci]\n");
	route(REPLY_ALIAS);
	if (has_body("application/sdp")) {
		$avp(extra_id) = @via[2].branch + $T_branch_idx;
		if (isbflagset(FLB_WS)) {
			rtpengine_answer("via-branch=extra {{ F.ws.pbx_answer }}");
		} else if (isbflagset(FLB_TLS)) {
			rtpengine_answer("via-branch=extra {{ F.tls.pbx_answer }}");
		} else {
			rtpengine_answer("via-branch=extra {{ F.plain.pbx_answer }}");
		}
	}
}

failure_route[DEV_FAILURE] {
	if (t_is_canceled()) {
		xlog("L_INFO", "devices: fork for $rU canceled (answered elsewhere or caller hung up) [ci=$ci]\n");
		exit;
	}
	xlog("L_INFO", "devices: every branch of $rU failed, best reply $T_reply_code [ci=$ci]\n");
	rtpengine_delete();
}

# A reply straight from a phone (not relayed by a peer edge, which already did this): remember
# its real address on the Contact so Asterisk's in-dialog requests reach it.
route[REPLY_ALIAS] {
{% for ip in edge_peer_ips %}
	if ($si == "{{ ip }}") return;
{% endfor %}
	if (proto == WS || proto == WSS || proto == TLS || nat_uac_test("19")) {
		add_contact_alias();
	}
}

# ---------------------------------------------------------------------------------------------
# Peer edge relaying an INVITE because the phone's connection lives on this node.
# The peer already engaged rtpengine; we only deliver.
# ---------------------------------------------------------------------------------------------
route[FROM_PEER] {
	# The INVITE carries OUR Path as a pre-loaded Route: <sip:{{ private_ip }}:5070;lr;received=...>.
	# Don't use loose_route() for it: on an initial request with a pre-loaded route it returns -3
	# ("next hop is taken from a preloaded route set", rr module docs), which `if (!...)` reads as
	# false, so every relayed call was refused with 403 (seen live 2026-11-14: every call to a
	# phone registered through edge-2 failed). Take the phone's address from ;received ourselves,
	# as DEV_BRANCH does on the sending edge.
	if (!is_present_hf("Route")) {
		xlog("L_WARN", "devices: relay from the peer edge without a Route, 403 [ci=$ci]\n");
		sl_send_reply("403", "Forbidden");
		exit;
	}
	$var(rt) = $(hdr(Route){nameaddr.uri});
	$var(rcv) = $(var(rt){uri.param,received}{s.unescape.param});
	if ($(var(rt){uri.host}) != "{{ private_ip }}" || $var(rcv) == $null || $var(rcv) == "") {
		xlog("L_WARN", "devices: relay from the peer edge with a Route that isn't our Path ($hdr(Route)), 403 [ci=$ci]\n");
		sl_send_reply("403", "Forbidden");
		exit;
	}
	remove_hf("Route");
	$du = $var(rcv);
	xlog("L_INFO", "devices: relaying for the peer edge to $du [ci=$ci]\n");
	record_route();
	t_on_reply("PEER_REPLY");
	route(SEND_PUBLIC);
	route(RELAY);
}

onreply_route[PEER_REPLY] {
	if (proto == WS || proto == WSS || proto == TLS || nat_uac_test("19")) {
		add_contact_alias();
	}
}

# ---------------------------------------------------------------------------------------------
# In-dialog requests (BYE, re-INVITE, REFER, NOTIFY, ACK for 2xx, ...)
# ---------------------------------------------------------------------------------------------
route[WITHINDLG] {
	if (!loose_route()) {
		if (is_method("ACK") && t_check_trans()) {
			route(RELAY);
		}
		sl_send_reply("404", "Not here");
		exit;
	}

	# Next hop is a NATed/WS/TLS client: restore its real address from the Contact ;alias.
	if (!isdsturiset()) {
		handle_ruri_alias();
	}

	if (is_method("BYE")) {
		rtpengine_delete();
	} else if (is_method("INVITE|UPDATE") && has_body("application/sdp")) {
		route(INDLG_SDP);
	}
	route(RELAY);
}

# re-INVITE / UPDATE with SDP: hold (a=sendonly or a=inactive), resume (a=sendrecv), session
# refresh. Same flags as the initial offer/answer for that leg and direction. rtpengine passes the
# a=sendonly/recvonly/inactive attributes through; Asterisk turns them into ChannelHold/Unhold.
#
# check_route_param() looks at OUR Record-Route entry, so a peer edge that only relays (FROM_PEER,
# no leg param) does nothing here; the edge that anchored the media does the rtpengine work.
# "From Asterisk" = FLT_PBX; anything else (carrier, vendor, phone, a peer edge relaying a phone's
# request) is the far side.
route[INDLG_SDP] {
{% for leg, fs in [('carrier', F.plain), ('vendor', F.plain), ('staff_udp', F.plain), ('staff_tls', F.tls), ('staff_ws', F.ws)] %}
	{% if not loop.first %}} else {% endif %}if (check_route_param("leg={{ leg }}")) {
		if (isflagset(FLT_PBX)) {
			rtpengine_offer("{{ fs.pbx_offer }}");
			$avp(rtp_answer) = "{{ fs.pbx_answer }}";
		} else {
			rtpengine_offer("{{ fs.far_offer }}");
			$avp(rtp_answer) = "{{ fs.far_answer }}";
		}
		t_on_reply("RTP_REPLY");
{% endfor %}
	}
}

# Generic answer handler: flags were chosen when the offer was sent (AVPs live in the transaction).
onreply_route[RTP_REPLY] {
	# Reply from a phone to Asterisk's re-INVITE: its Contact becomes Asterisk's new remote target,
	# so it needs the ;alias too (like DEV_REPLY).
	if (isflagset(FLT_PBX)) route(REPLY_ALIAS);
	if (has_body("application/sdp") && $avp(rtp_answer) != $null) {
		rtpengine_answer("$avp(rtp_answer)");
	}
}

# ---------------------------------------------------------------------------------------------
# WebSocket handshake (HTTP Upgrade) from HAProxy
# ---------------------------------------------------------------------------------------------
event_route[xhttp:request] {
	set_reply_close();
	set_reply_no_connect();
	if ($Rp != {{ kamailio_ws_port }}) {
		xhttp_reply("403", "Forbidden", "", "");
		exit;
	}
	if ($hdr(Upgrade) =~ "websocket" && $hdr(Connection) =~ "Upgrade" && $rm =~ "GET") {
		if (ws_handle_handshake()) {
			exit;
		}
	}
	xhttp_reply("404", "Not Found", "", "");
}
