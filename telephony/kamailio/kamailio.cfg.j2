{% if kamailio_sipdump | default(true) %}
# ----- sipdump: SIP history (2026-11-15) -----
# Every SIP message this edge receives or sends, on every transport, written by a separate writer
# process to hourly pcap files. TLS phones and browsers (WebSocket) are written AFTER decryption, so
# their calls and REGISTERs become searchable too (the old tcpdump ring saw UDP only). Mode 4 =
# pcap, + 8 = a P-KSR-SIPDump header in each written message with the real transport and addresses
# (the pcap's own IP/UDP headers are synthetic for TCP/TLS/WS). Search with
# loadtest/diag/sip-history.py. Kill switch without a restart: `kamcmd sipdump.enable 0`.
modparam("sipdump", "enable", 1)
modparam("sipdump", "mode", 12)
modparam("sipdump", "wait", 10000)        # µs the writer sleeps when idle (default 100 = busy on 1 vCPU)
modparam("sipdump", "rotate", 3600)       # one file per hour
modparam("sipdump", "folder", "{{ kamailio_sipdump_dir | default('/var/log/pbx/sipdump') }}")
modparam("sipdump", "fprefix", "sip-")
# fage only applies after a Kamailio restart; the hourly pbx-sipdump-prune timer (role kamailio)
# enforces the same age plus a size cap without one (2026-11-22: 18 GB on edge-2 at ~0.9 GB/h).
modparam("sipdump", "fage", {{ (kamailio_sipdump_keep_hours | default(12)) * 3600 }})   # s
{% endif %}

# ----- tls (phones registering over _sips._tcp) -----
modparam("tls", "config", "/etc/kamailio/tls.cfg")

# ----- tm -----
modparam("tm", "failure_reply_mode", 3)
modparam("tm", "fr_timer", 5000)          # ms: no reply at all (phones: route[DEV_TIMERS])
modparam("tm", "fr_inv_timer", 120000)    # ms: provisional received, waiting for final

# ----- rr -----
modparam("rr", "enable_full_lr", 0)
# No ;ftag= in Record-Route: only is_direction() needs it and this config never calls it. Each
# ftag costs ~42 bytes per Record-Route (two per request), and requests to UDP phones must fit
# in one packet (2026-11-14: a 1,609-byte INVITE was fragmented and never reached a NATed phone).
modparam("rr", "append_fromtag", 0)
# Two Record-Route headers when the in/out sockets differ (public<->internal, ws<->udp), each with
# that socket's (advertised) address; loose_route() then forces the matching socket in-dialog.
modparam("rr", "enable_double_rr", 1)

# ----- database: READ-ONLY connection, auth + DID lookups only (B1) -----
# Points at the local DB proxy's "any healthy member" port (replicas preferred), so a Patroni
# failover does not stop authentication. Nothing in Kamailio writes to Postgres any more.
modparam("db_postgres", "timeout", 2)
modparam("sqlops", "sqlcon", "ro=>{{ kamailio_db_ro_url }}")

# ----- usrloc / registrar: in memory, replicated to the other edges with DMQ (B1) -----
# Phase 1 used db_mode=3: every REGISTER and every lookup was a round trip to the Patroni primary,
# and a primary failover stopped all registrations and all calls to phones.
modparam("usrloc", "db_mode", 0)
modparam("usrloc", "use_domain", 0)       # one SIP domain; sip_username is globally unique
modparam("usrloc", "timer_interval", 30)

modparam("registrar", "use_path", 1)
modparam("registrar", "path_mode", 0)     # store Path even if the client doesn't support it
modparam("registrar", "path_use_received", 0)
modparam("registrar", "default_expires", 300)
modparam("registrar", "min_expires", 60)
modparam("registrar", "max_expires", 600)
# "Any number of phones register" per extension: no cap. A reconnecting phone re-registers with the
# same Contact URI and replaces its own old binding (usrloc matching on Contact).
modparam("registrar", "max_contacts", 0)

# path: when a peer edge relays to us with our Path as Route, deliver to the "received" address
# (the phone's connection) stored in it.
modparam("path", "use_received", 1)

# ----- dmq: replicate registrations between edges -----
# Internal socket on every edge (sent from the default socket, which is the internal one).
modparam("dmq", "server_address", "sip:{{ private_ip }}:{{ kamailio_internal_port }}")
{% if edge_peer_ips | length > 0 %}
{% for ip in edge_peer_ips %}
modparam("dmq", "notification_address", "sip:{{ ip }}:{{ kamailio_internal_port }}")
{% endfor %}
{% else %}
modparam("dmq", "notification_address", "sip:{{ private_ip }}:{{ kamailio_internal_port }}")
{% endif %}
modparam("dmq", "multi_notify", 1)
modparam("dmq", "num_workers", 4)
modparam("dmq_usrloc", "enable", 1)
# On start, pull the full location table from a peer (an edge that restarts keeps every phone).
modparam("dmq_usrloc", "sync", 1)

# ----- auth -----
modparam("auth_db", "db_url", DBURL_RO)
modparam("auth_db", "calculate_ha1", yes)
modparam("auth_db", "password_column", "password")
# The extension's account comes along with the credentials: used to keep an account's calls on
# one pbx node (attended transfer needs both calls on the same Asterisk, B5).
modparam("auth_db", "load_credentials", "$avp(tenant)=tenant_id")
modparam("auth_db", "use_domain", 0)

# ----- htable: DID -> account cache (for pbx-node affinity of carrier calls) -----
modparam("htable", "htable", "didt=>size=12;autoexpire=300;")
# vendor host -> last IPv4 that resolved, and <host>::at = time of the last lookup (route[VENDOR_DST])
modparam("htable", "htable", "vdns=>size=4;autoexpire=0;")

# ----- dispatcher: set 1 = pbx (Asterisk) nodes -----
modparam("dispatcher", "list_file", "/etc/kamailio/dispatcher.list")
modparam("dispatcher", "flags", 2)                 # failover support (ds_next_dst)
modparam("dispatcher", "ds_ping_interval", 5)
modparam("dispatcher", "ds_probing_threshold", 2)
modparam("dispatcher", "ds_inactive_threshold", 2)
modparam("dispatcher", "ds_probing_mode", 1)       # always probe, so dead nodes come back automatically
modparam("dispatcher", "ds_ping_from", "sip:dispatcher@{{ private_ip }}")
modparam("dispatcher", "ds_ping_reply_codes", "class=2")
# Algorithm 7 hashes this value: the account id, so all of an account's calls land on one node.
modparam("dispatcher", "hash_pvar", "$avp(dshash)")

# ----- rtpengine: the SAME set on every edge, so any edge can handle any call's in-dialog requests.
# Node choice is a hash of the Call-ID.
{% if MEDIA %}
# Set 0 (default) = the edges, written exactly as before the media nodes existed, so a call already
# anchored on an edge hashes to the same node after the restart. Set 1 = the media nodes.
modparam("rtpengine", "rtpengine_sock", "{% for ip in rtpengine_edge_ips %}udp:{{ ip }}:2223{% if not loop.last %} {% endif %}{% endfor %}")
modparam("rtpengine", "rtpengine_sock", "1 == {% for ip in rtpengine_media_ips %}udp:{{ ip }}:2223{% if not loop.last %} {% endif %}{% endfor %}")
# Set per message from this AVP (unset = set 0). Transaction AVPs reach reply and failure routes.
modparam("rtpengine", "setid_avp", "$avp(rtpset)")
{% else %}
modparam("rtpengine", "rtpengine_sock", "{% for ip in rtpengine_ips %}udp:{{ ip }}:2223{% if not loop.last %} {% endif %}{% endfor %}")
{% endif %}
modparam("rtpengine", "rtpengine_disable_tout", 20)
# Wait per attempt for rtpengine's reply. Measured 2026-11-14 (10 min, 191 commands): replies take
# 0.2-6 ms (same edge < 1.5 ms, cross-edge 1-6 ms). With 1000 ms, ONE lost UDP packet held the SIP
# message for exactly 1 s (a re-INVITE's 200 OK took 1.008 s; the course's re-INVITE p95 ~1 s),
# and the cross-edge path does lose them: twice in 3 days both attempts were lost (ERROR "timeout
# waiting reply" for ping on each edge; a loss recovered by the resend isn't logged). 250 ms caps a
# single loss at 0.25 s; 3 attempts keep 750 ms of patience for an rtpengine busy transcoding.
# Resending is safe: rtpengine answers a repeated cookie from its cache without redoing the command.
# 2026-11-14: 100 ms x 7. Half of all calls use the OTHER edge's rtpengine (Call-ID hash), and
# new TCP connections from edge-1 to private peers stall on a lost SYN 0.5-0.8% of the time (UDP
# commands are as exposed): each loss in a re-INVITE/answer showed up as a 200-300 ms SIP
# transaction in the course's histogram. Replies take < 10 ms, so 100 ms is still 10x the worst
# reply seen; 7 attempts keep 700 ms of patience.
# 2026-11-17: 100 ms x 20 (2 s of patience). The media nodes' control thread sometimes stalls for
# ~0.8 s (~40 times an hour per node; every resend then arrives in the same microsecond and is
# answered from the cache). With 7 attempts a 0.8 s stall marked a healthy node dead for
# rtpengine_disable_tout (20 s), and every call hashed to it failed with "no available proxies"
# (03:06 burst = the course's 03:08 failure spike). A truly dead node now costs the first message
# per worker 2 s instead of 0.7 s before it is disabled. Single lost packets still cost 0.1 s.
modparam("rtpengine", "rtpengine_tout_ms", 100)
modparam("rtpengine", "rtpengine_retr", 20)
# Forking: each branch toward a phone gets its own media leg in rtpengine (via-branch=extra with
# a per-branch id), otherwise the branches' offers overwrite each other and the answering phone
# can end up with no audio.
modparam("rtpengine", "extra_id_pv", "$avp(extra_id)")

# ----- nathelper -----
modparam("nathelper", "natping_interval", 0)       # clients keep their own NAT bindings alive

# ----- websocket -----
modparam("websocket", "keepalive_mechanism", 1)    # send WS pings
modparam("websocket", "keepalive_timeout", 30)
modparam("websocket", "keepalive_interval", 1)

# ----- pike (light flood protection for untrusted sources; course testers exempt, B2) -----
modparam("pike", "sampling_time_unit", 2)
modparam("pike", "reqs_density_per_unit", {{ kamailio_pike_density | default(200) }})
modparam("pike", "remove_latency", 4)

# ----- control interfaces (kamcmd / kamctl) -----
modparam("ctl", "binrpc", "unix:/run/kamailio/kamailio_ctl")
modparam("jsonrpcs", "pretty_format", 1)

####### Routing Logic ########

request_route {
	route(CLASSIFY);
	route(REQINIT);

	if (is_method("KDMQ")) {
		route(DMQ);
		exit;
	}

	if (is_method("CANCEL")) {
		if (t_check_trans()) {
{% if MEDIA %}
			# The INVITE's AVPs aren't loaded for its CANCEL: use the switch as it is now (right unless it
			# was flipped while this call was ringing; then rtpengine's no-media timeout cleans up).
			route(RTP_SET_NEW);
{% endif %}
			rtpengine_delete();
			route(RELAY);
		}
		exit;
	}

	# Retransmissions of requests we're already handling.
	# t_precheck_trans() is true while ANOTHER worker is still running this same request through the
	# script (e.g. waiting on rtpengine's offer in DEV_BRANCH). Drop the copy without touching the
	# transaction: in Kamailio 6.0.8, t_check_trans() here finds that transaction before it has a
	# branch, and at the end of this message tm releases it ("dropping orphaned transaction without
	# branches ... kr=8"). The INVITE still goes out, but a 200 OK arriving > ~5 s later matches
	# nothing, is relayed statelessly (no DEV_REPLY, no rtpengine_answer) and Asterisk gets the
	# phone's own SDP: a silent call (2026-11-17, docs/incidents/2026-11-17-orphan-transaction.md).
	# Upstream fix: kamailio 5479f28 (6.0 branch, after 6.0.8). The sender resends again (Asterisk
	# after 200 ms), and by then the transaction has its branches and t_check_trans() below absorbs it.
	if (!is_method("ACK")) {
		if (t_precheck_trans()) {
			exit;
		}
		t_check_trans();
	}

	route(NATDETECT);

	if (has_totag()) {
		route(WITHINDLG);
		exit;
	}

	if (is_method("REGISTER")) {
		route(REGISTRAR);
		exit;
	}

	if (is_method("INVITE")) {
		if (isflagset(FLT_PEER)) route(FROM_PEER);
		if (isflagset(FLT_CARRIER)) route(FROM_CARRIER);
		if (isflagset(FLT_PBX)) {
			if ({% for h in vendor_hosts %}$rd == "{{ h }}"{% if not loop.last %} || {% endif %}{% endfor %}) route(TO_VENDOR);
			route(TO_DEVICES);
		}
		route(FROM_DEVICE);
		exit;
	}

	if (is_method("ACK")) {
		# ACK for a non-2xx reply is absorbed by tm; anything else here is stray.
		exit;
	}

	sl_send_reply("403", "Forbidden");
	exit;
}

# Every reply, before tm matches it. Only one case needs work: a reply relayed STATELESSLY (no
# transaction left, e.g. Asterisk's 200 OK retransmissions after tm's wait timer) goes out of the
# socket the core picks from the next hop's address. The internal and public UDP sockets share the
# private IP (1:1 NAT) and the internal one is listed first, so such a reply to a phone or the
# carrier left from :{{ kamailio_internal_port }} instead of :5060, which clients may ignore: if the first 200 OK
# is lost, every retransmission was wasted and the call failed after 32 s without an ACK
# (2026-11-17 14:31 UTC, synthetic call on edge-1). Replies relayed by tm keep the socket the
# request arrived on, so forcing here changes nothing for them. Checked on Kamailio 6.0.8: without
# this the relayed reply leaves from the first socket, with it from the forced one; a private next
# hop keeps the internal socket.
{# Our own hops on the private network: the pbx nodes and the peer edges (also used by NH_TIMERS). #}
{% set private_hops = ((groups.get('pbx', []) | map('extract', hostvars, 'private_ip') | list) + edge_peer_ips) | reject('equalto', private_ip) | unique | list %}
reply_route {
	if ($Rp == {{ kamailio_internal_port }} && $(sel(via[2].transport){s.tolower}) == "udp") {
{% if private_hops %}
		if ({% for ip in private_hops %}$sel(via[2].host) != "{{ ip }}"{% if not loop.last %} && {% endif %}{% endfor %}) {
			force_send_socket(udp:{{ public_bind_ip }}:5060);
		}
{% else %}
		force_send_socket(udp:{{ public_bind_ip }}:5060);
{% endif %}
	}
	# A party's 2xx to an INVITE that no longer has a transaction: mostly a phone answering AFTER
	# we gave up on it (no reply within the phone-branch timer -> 408 to Asterisk), relayed without
	# rtpengine, so Asterisk gets the phone's own SDP for a call it already ended (2026-11-17 14:32
	# UTC: a TLS phone answered 11 s late and hung up into a dead call). Also the phone resending
	# its 200 OK after the transaction ended. Kept relaying: Asterisk ACKs it and the phone hangs up
	# at once; dropping it would leave the phone resending for 32 s. Logged so these can be counted
	# (journalctl -u kamailio | grep "late 2xx").
	if ($Rp != {{ kamailio_internal_port }} && $rm == "INVITE" && status =~ "^2[0-9][0-9]$" && !t_check_trans()) {
		xlog("L_WARN", "devices: late 2xx from $si:$sp ($pr) with no transaction, relayed as is [ci=$ci]\n");
	}
}

# Who sent this request? Sets FLT_CARRIER / FLT_PBX / FLT_PEER / FLT_DEVICE_SRC (+ FLT_TRUSTED,
# FLT_PRIVNET).
route[CLASSIFY] {
{# carrier_cidrs / trusted_tester_cidrs entries: "IP", "IP/bits", optionally ":port" (carrier only).
   A port pins the carrier to one source port, so phones on the SAME machine (local testing: SIPp
   carrier on :5062, MicroSIP phone on :5060) are still treated as phones. #}
{% macro net(entry) %}{% set n = entry.split(':')[0] %}{{ n if '/' in n else n ~ '/32' }}{% endmacro %}
{% for entry in (carrier_cidrs + trusted_tester_cidrs) %}
	if (is_in_subnet("$si", "{{ net(entry) }}")) setflag(FLT_TRUSTED);
{% endfor %}
{% for entry in carrier_cidrs %}
	if (is_in_subnet("$si", "{{ net(entry) }}"){% if ':' in entry %} && $sp == {{ entry.split(':')[1] }}{% endif %} && $pr == "udp") {
		setflag(FLT_CARRIER);
		return;
	}
{% endfor %}
	# Matches source IP + port + protocol against the dispatcher list (Asterisk nodes).
	if (ds_is_from_list("1")) {
		setflag(FLT_PBX);
		return;
	}
{% for ip in edge_peer_ips %}
	if ($si == "{{ ip }}" && $pr == "udp") {
		setflag(FLT_PEER);
		return;
	}
{% endfor %}
	# A device on the platform's private network (our own nodes matched above). Since 2026-11-23
	# the course's simulators send part of their phones' REGISTERs and calls to our private IPs:
	# pike blocked 4,647 requests from 4 of those hosts in 8 minutes (REGISTER failures).
	# Their media then uses rtpengine's private address (;pn=1). [VERIFY V-A9]
{% for entry in private_device_cidrs | default([]) %}
	# (WebSocket requests come from HAProxy on an edge: trusted, but browsers keep their own flags.)
	if (is_in_subnet("$si", "{{ net(entry) }}")) {
		setflag(FLT_TRUSTED);
		if ($pr != "ws" && $pr != "wss") setflag(FLT_PRIVNET);
	}
{% endfor %}
	setflag(FLT_DEVICE_SRC);
}

route[REQINIT] {
	if (!mf_process_maxfwd_header("10")) {
		sl_send_reply("483", "Too Many Hops");
		exit;
	}
	if (!sanity_check("17895", "7")) {
		xlog("L_WARN", "malformed request from $si:$sp\n");
		exit;
	}
	if (isflagset(FLT_DEVICE_SRC) && !isflagset(FLT_TRUSTED)) {
		# Anything on the public internet gets scanned; drop the well-known scanners silently.
		if ($ua =~ "friendly-scanner|sipcli|sipvicious|sip-scan|VaxSIPUserAgent|pplsip") {
			exit;
		}
		# The course's simulated phones come from a few IPs (FLT_TRUSTED): never rate-limit them.
		if (!pike_check_req()) {
			xlog("L_ALERT", "pike blocking $rm from $si:$sp\n");
			exit;
		}
	}
	# Our internal headers (account, source) can only come from us.
	if (!isflagset(FLT_PBX) && !isflagset(FLT_PEER)) {
		remove_hf_re("^X-PBX-");
	}
	# Keepalive / dispatcher probes / Asterisk qualify addressed to us.
	if (is_method("OPTIONS") && uri == myself && $rU == $null) {
		sl_send_reply("200", "OK");
		exit;
	}
}

# Phones (UDP behind NAT, TLS, WS) put unreachable addresses in Contact; remember the real source
# with an ;alias param so in-dialog requests can find them again.
route[NATDETECT] {
	if (!isflagset(FLT_DEVICE_SRC)) return;
	force_rport();
	if (!is_method("REGISTER") && (nat_uac_test("83") || $pr == "tls")) {   # 1+2+16+64 (64 = WebSocket)
		if (!add_contact_alias()) {
			xlog("L_ERR", "cannot alias contact <$ct>\n");
			sl_send_reply("400", "Bad Request");
			exit;
		}
	}
}

route[RELAY] {
	route(NH_TIMERS);
	if (!t_relay()) {
		sl_reply_error();
	}
	exit;
}

# Next hop is Asterisk or the peer edge over the private network (RTT < 5 ms): resend a lost UDP
# request after 100 ms (then 200, 400, 400...) instead of SIP's default T1 of 500 ms. Without this,
# one lost packet on that hop added 0.5 s to the transaction (2026-11-14: a carrier re-INVITE's
# first copy to Asterisk got no answer; the resend 444 ms later was answered in 1.4 ms). Requests
# to the internet keep the defaults. tm never retransmits over TCP/TLS/WS, so only UDP is affected.
# (private_hops is set above reply_route.)
route[NH_TIMERS] {
{% if private_hops %}
	if ({% for ip in private_hops %}$nh(d) == "{{ ip }}"{% if not loop.last %} || {% endif %}{% endfor %}) {
		t_set_retr(100, 400);
	}
{% endif %}
	return;
}

# A new request leaves toward the internet (carrier, vendor, phone): send it from the public UDP
# socket so its Via / Record-Route carry the public (advertised) address. TLS and WS have one
# socket each, which the transport already selects. In-dialog requests don't need this: the
# double Record-Route makes loose_route() pick the socket.
route[SEND_PUBLIC] {
	if ($du != $null && $du != "") {
		$var(np) = $(du{uri.transport});
	} else {
		$var(np) = $(ru{uri.transport});
	}
	if ($var(np) == $null || $var(np) == "" || $var(np) =~ "^(udp|UDP)$") {
		force_send_socket(udp:{{ public_bind_ip }}:5060);
	}
}

route[DMQ] {
	# Registration replication between edges only.
	if (!isflagset(FLT_PEER) && $si != "{{ private_ip }}") {
		sl_send_reply("403", "Forbidden");
		exit;
	}
	dmq_handle_message();
	exit;
}

# ---------------------------------------------------------------------------------------------
# REGISTER: desk phones (UDP/TLS) and browsers (WS). Any number per extension.
# ---------------------------------------------------------------------------------------------
route[REGISTRAR] {
	# Asterisk and peer edges never register. Carrier IPs may (in testing, SIPp acts as both the
	# carrier and a phone from one machine); auth below is still required.
	if (isflagset(FLT_PBX) || isflagset(FLT_PEER)) {
		sl_send_reply("403", "Forbidden");
		exit;
	}
	if (!auth_check("$fd", "subscriber", "1")) {
		auth_challenge("$fd", "1");
		exit;
	}
	consume_credentials();

	# Path = "reach this contact through THIS edge". The received param is where the client
	# actually is (for a browser: HAProxy's connection to us, which carries the WebSocket).
	# Another edge that looks this user up relays the call to us via Path; we use received.
	$var(rcv) = "sip:" + $si + ":" + $sp + ";transport=" + $pr;
	remove_hf("Path");
	append_hf("Path: <sip:{{ private_ip }}:{{ kamailio_internal_port }};lr;received=$(var(rcv){s.escape.param})>\r\n");
	# Apply the header change so registrar sees the Path we just added.
	if (!msg_apply_changes()) {
		sl_send_reply("500", "Server Error");
		exit;
	}
	if (!save("location")) {
		sl_reply_error();
	}
	exit;
}

# ---------------------------------------------------------------------------------------------
# Pick a pbx node: hash on the account so all of its calls share one Asterisk (B5); round-robin
# when the account is unknown. ds_next_dst() fails over in hash order.
# ---------------------------------------------------------------------------------------------
route[PBX_SELECT] {
	$avp(dshash) = $var(tenant);
	$var(alg) = 7;
	if ($var(tenant) == "" || $var(tenant) == $null) $var(alg) = 4;
	if (!ds_select_dst("1", "$var(alg)")) {
		xlog("L_ERR", "no pbx node available for $rU\n");
		send_reply("503", "Service Unavailable");
		exit;
	}
}

# Before relaying to a pbx node (initial try and each failover).
route[PBX_TIMERS] {
	# 2 s to get any reply from the pbx node before trying the next one; 120 s once ringing.
	t_set_fr(120000, 2000);
	t_on_reply("RTP_REPLY");
	t_on_failure("PBX_FAILOVER");
}

{% if MEDIA %}
# rtpengine set for a NEW call, from the live switch (see the header). Sets $avp(rtpset), which
# the rtpengine module reads for every command of this transaction (setid_avp).
route[RTP_SET_NEW] {
	if ($sel(cfg_get.pbx.media_rtp) == 1) $avp(rtpset) = 1;
}

# Remember the set in the Record-Route being built, for the call's in-dialog requests (on either
# edge, and after a Kamailio restart). Call right before record_route().
route[RTP_SET_RR] {
	if ($avp(rtpset) == 1) add_rr_param(";rs=1");
}

{% endif %}
failure_route[PBX_FAILOVER] {
	if (t_is_canceled()) exit;
	# 503: ARI app down (dialplan Hangup(34)) or overloaded. Timeout: node dead.
	# The SDP rewritten by rtpengine_offer in request_route is kept for the new branch.
	# NOT 500: that is the ARI app failing ONE call (reason=failure, e.g. its vendor leg failed), and
	# the node is fine. Until 2026-11-20 a 500 marked the node inactive too: during a 1-min DNS
	# outage for us-vendor, each phone call to an external number marked all 3 pbx nodes inactive
	# in turn (19:49-19:50, 5 times, ~3-4 s each) and every other call got 503 "no pbx node
	# available" (docs/incidents/2026-11-20-support-tickets.md §2). The 500 goes to the caller.
	#
	# Only a node that did not answer at all is marked inactive (until it answers OPTIONS again).
	# A 503 moves THIS call to the next node and leaves the node in service: it is usually
	# Asterisk at maxcalls, which frees a slot with the next hangup. Until 2026-11-24 a 503 marked
	# the node inactive too: at the 11-23 Monday peak every pbx node sat at its cap, each 503 took
	# a whole node out for 5-10 s, its freed slots went unused, and the failed_503s piled up
	# (~150/min). Marking gained nothing for the other 503s either: an ARI-app-down node still
	# answers OPTIONS, so probing switched it back on within seconds anyway, and inbound.ts's
	# deliberate 503 (`congestion`, one carrier call failing before answer) is a per-call retry.
	if (t_check_status("503") || (t_branch_timeout() && !t_branch_replied())) {
		xlog("L_WARN", "pbx $du failed ($T_reply_code), trying next\n");
		if (!t_check_status("503")) {
			ds_mark_dst("ip");   # timeout: inactive + probing until it answers OPTIONS again
		}
		if (ds_next_dst()) {
			route(PBX_TIMERS);
			route(NH_TIMERS);
			t_relay();
			exit;
		}
	}
	rtpengine_delete();
}

# ---------------------------------------------------------------------------------------------
# carrier -> Asterisk: a PSTN call to one of our DIDs
# ---------------------------------------------------------------------------------------------
route[FROM_CARRIER] {
	if (!($rU =~ "^\+?[0-9]{4,16}$")) {
		sl_send_reply("404", "Not Found");
		exit;
	}
	# DID -> account, cached; a DB hiccup only costs affinity (fall back to hashing the DID).
	# Failures are cached too (autoexpire), so a DB outage costs ONE timeout per DID, not one per call
	# (post-dial delay is graded).
	#
	# Test the cache entry ITSELF for $null: a $var can't hold $null (assigning $null stores the
	# integer 0). Until 2026-11-15 this copied $sht into $var(tenant) first, so the miss check never
	# matched, the lookup never ran (the didt table stayed empty), and 0 == "-" (compared as
	# integers) made every carrier call hash on its DID instead of its account: one account's
	# numbers landed on different pbx nodes (Allen: 213/888 -> pbx-1, 718 -> pbx-2, its phones ->
	# pbx-2), which breaks attended transfer between those calls.
	$var(did) = $rU;
	if ($(rU{s.substr,0,1}) == "+") $var(did) = $(rU{s.substr,1,0});
	if ($sht(didt=>$var(did)) == $null) {
		$var(found) = "-";
		if (sql_query("ro", "select tenant_id from public.kamailio_did_tenant where did_digits = '$var(did)' limit 1", "ra")) {
			if ($dbr(ra=>rows) > 0) $var(found) = $dbr(ra=>[0,0]);
			sql_result_free("ra");
		}
		$sht(didt=>$var(did)) = $var(found);
	}
	$var(tenant) = $sht(didt=>$var(did));
	if ($var(tenant) == "-") $var(tenant) = $var(did);

	append_hf("X-PBX-Src: carrier\r\n");
	route(PBX_SELECT);
{% if MEDIA %}
	route(RTP_SET_NEW);
	route(RTP_SET_RR);
{% endif %}
	add_rr_param(";leg=carrier");
	record_route();
	if (!rtpengine_offer("{{ F.plain.far_offer }}")) {
		xlog("L_ERR", "rtpengine offer failed for carrier call\n");
		send_reply("503", "Media Unavailable");
		exit;
	}
	$avp(rtp_answer) = "{{ F.plain.far_answer }}";
	route(PBX_TIMERS);
	route(RELAY);
}

# ---------------------------------------------------------------------------------------------
# phone -> Asterisk: a customer's desk phone or softphone places a call (extension, *98, PSTN)
# ---------------------------------------------------------------------------------------------
route[FROM_DEVICE] {
	if (!auth_check("$fd", "subscriber", "1")) {
		auth_challenge("$fd", "1");   # 407 for INVITE
		exit;
	}
	$var(user) = $au;
	$var(tenant) = $avp(tenant);
	consume_credentials();

	append_hf("X-PBX-Src: device\r\n");
	append_hf("X-PBX-User: $var(user)\r\n");
	route(PBX_SELECT);
{% if MEDIA %}
	route(RTP_SET_NEW);
	route(RTP_SET_RR);
{% endif %}

	if ($pr == "ws" || $pr == "wss") {
		add_rr_param(";leg=staff_ws");
		record_route();
		rtpengine_offer("{{ F.ws.far_offer }}");
		$var(ok) = $rc;
		$avp(rtp_answer) = "{{ F.ws.far_answer }}";
	} else if ($pr == "tls") {
		add_rr_param(";leg=staff_tls");
		if (isflagset(FLT_PRIVNET)) {
			add_rr_param(";pn=1");
			record_route();
			rtpengine_offer("{{ FP.tls.far_offer }}");
		} else {
			record_route();
			rtpengine_offer("{{ F.tls.far_offer }}");
		}
		$var(ok) = $rc;
		$avp(rtp_answer) = "{{ F.tls.far_answer }}";
	} else {
		add_rr_param(";leg=staff_udp");
		if (isflagset(FLT_PRIVNET)) {
			add_rr_param(";pn=1");
			record_route();
			rtpengine_offer("{{ FP.plain.far_offer }}");
		} else {
			record_route();
			rtpengine_offer("{{ F.plain.far_offer }}");
		}
		$var(ok) = $rc;
		$avp(rtp_answer) = "{{ F.plain.far_answer }}";
	}
	if ($var(ok) < 0) {
		xlog("L_ERR", "rtpengine offer failed for call from $var(user)\n");
		send_reply("503", "Media Unavailable");
		exit;
	}
	route(PBX_TIMERS);
	route(RELAY);
}

# ---------------------------------------------------------------------------------------------
# Asterisk -> PSTN vendor (outgoing call, forwarding, simultaneous ring, transfer to a number).
# Asterisk sends it with us as outbound proxy and answers the vendor's 401/407 itself.
# ---------------------------------------------------------------------------------------------
# The ARI app tags each ring leg it originates with X-PBX-Leg: <its ARI channel id>. Log it once,
# next to this leg's SIP Call-ID, and strip it (it's ours, not the phone's or the vendor's). Joins
# the app's "ring: answered" / "ring: leg ended" lines (channel id, caller's Call-ID) to the leg's
# audio record on the media node (its own Call-ID): loadtest/diag/silent-legs.py (2026-11-18).
route[LEG_TAG] {
	if (is_present_hf("X-PBX-Leg")) {
		xlog("L_INFO", "legs: $hdr(X-PBX-Leg) is [ci=$ci] to $rU\n");
		remove_hf("X-PBX-Leg");
	}
}

route[TO_VENDOR] {
	route(LEG_TAG);
	if (is_present_hf("Route")) loose_route();   # our own pre-loaded Route from Asterisk
	route(VENDOR_DST);
{% if MEDIA %}
	route(RTP_SET_NEW);
	route(RTP_SET_RR);
{% endif %}
	add_rr_param(";leg=vendor");
	record_route();
	if (!rtpengine_offer("{{ F.plain.pbx_offer }}")) {
		send_reply("503", "Media Unavailable");
		exit;
	}
	$avp(rtp_answer) = "{{ F.plain.pbx_answer }}";
	t_on_reply("RTP_REPLY");
	t_on_failure("VENDOR_FAILURE");
	route(SEND_PUBLIC);
	route(RELAY);
}

# Where a vendor leg goes: $du = sip:<IPv4>:5060, so t_relay never resolves the vendor host on the
# call path. The Request-URI keeps the host name. Why: when the platform resolver 10.0.0.2 fails,
# Kamailio's own lookup gives up after ~2 s and answers Asterisk 478 Unresolvable destination
# (2026-11-23 07:43-07:52 UTC: ~60 legs, grader `us` 12 failures/min; also 11-20 and 11-21).
# systemd-resolved's serve-stale (V-P13) served nothing during that outage.
#   - At most one lookup per host every {{ vendor_dns_recheck_sec }} s (htable vdns, shared by all
#     workers), so an address change is picked up within a minute, and during an outage only the
#     call that does the lookup waits for it; every other call uses the stored address at once.
#   - A failed lookup keeps the last address that resolved. If none has resolved since Kamailio
#     started, the deploy-time address (vendor_fallback_ips) is used.
#   - The vendors publish no SRV records (_sip._udp: NXDOMAIN), so an A lookup + port 5060 is what
#     t_relay resolved before.
route[VENDOR_DST] {
	if ($du != $null && $du != "") return;
	$var(vh) = $rd;
	if ($sht(vdns=>$var(vh)::at) == $null || $Ts - $sht(vdns=>$var(vh)::at) >= {{ vendor_dns_recheck_sec }}) {
		$sht(vdns=>$var(vh)::at) = $Ts;   # before the lookup: concurrent calls don't all look up
		if (dns_query("$var(vh)", "vd")) {
			if ($dns(vd=>type[0]) == 4) {
				$sht(vdns=>$var(vh)) = $dns(vd=>addr[0]);
			} else if ($dns(vd=>type[1]) == 4) {
				$sht(vdns=>$var(vh)) = $dns(vd=>addr[1]);
			}
		} else {
			xlog("L_WARN", "vendor dns: lookup of $var(vh) failed, keeping $sht(vdns=>$var(vh)) [ci=$ci]\n");
		}
	}
	if ($sht(vdns=>$var(vh)) != $null) {
		$var(vip) = $sht(vdns=>$var(vh));
	} else {
		$var(vip) = "";
{% for v in vendor_fallback_ips %}
		if ($var(vh) == "{{ v.host }}") $var(vip) = "{{ v.ip }}";
{% endfor %}
		if ($var(vip) != "") xlog("L_WARN", "vendor dns: no address for $var(vh) yet, using deploy-time $var(vip) [ci=$ci]\n");
	}
	if ($var(vip) == "") return;   # unknown vendor host and no lookup yet: t_relay resolves it
	$du = "sip:" + $var(vip) + ":5060";
}

failure_route[VENDOR_FAILURE] {
	if (t_is_canceled()) exit;
	# 401/407: Asterisk re-sends with credentials on the same Call-ID; keep the media session.
	if (!t_check_status("401|407")) rtpengine_delete();
}

# ---------------------------------------------------------------------------------------------
# Asterisk -> every registered device of one extension (parallel fork)
# ---------------------------------------------------------------------------------------------
route[TO_DEVICES] {
	route(LEG_TAG);
	if (!lookup("location")) {
		# No device registered: the ARI app treats it as "no answer" (forward / voicemail).
		# Fork logging (L_INFO, shown at debug=2): which extension rang which contact, and how each
		# branch ended. Needed to tell "desk phone never rang" from "desk phone lost the race".
		xlog("L_INFO", "devices: $rU has no registered contact, 480 [ci=$ci]\n");
		send_reply("480", "Temporarily Unavailable");
		exit;
	}
	# Keep the INVITE inside one UDP packet (path MTU 1,450 on the edges). Measured 2026-11-14:
	# 1,602-1,609 bytes, sent as two IP fragments, and a phone behind a NAT that drops fragments
	# (campus network) never rang, retransmissions included. Cut what a phone doesn't use (~140 B):
	#  - P-Asserted-Identity repeats From (phones and the softphone show From without it);
	#  - User-Agent;
	#  - Supported: keep 100rel, timer (session refresh), replaces (attended transfer);
	#  - Allow: keep what a phone may send in this dialog (UPDATE, PRACK, INFO DTMF, REFER and its
	#    NOTIFYs for transfer, OPTIONS); drop REGISTER, SUBSCRIBE, PUBLISH, MESSAGE.
	# Plus no ;ftag in Record-Route (rr append_fromtag 0, ~84 B).
	remove_hf("P-Asserted-Identity");
	remove_hf("User-Agent");
	if (is_present_hf("Supported")) {
		remove_hf("Supported");
		append_hf("Supported: 100rel, timer, replaces\r\n");
	}
	if (is_present_hf("Allow")) {
		remove_hf("Allow");
		append_hf("Allow: INVITE, ACK, BYE, CANCEL, OPTIONS, UPDATE, PRACK, INFO, REFER, NOTIFY\r\n");
	}
{% if MEDIA %}
	# One set for every branch of this fork (the AVP reaches DEV_BRANCH, DEV_REPLY, DEV_FAILURE).
	route(RTP_SET_NEW);
{% endif %}
	t_on_branch("DEV_BRANCH");
	t_on_reply("DEV_REPLY");
	t_on_failure("DEV_FAILURE");
	route(DEV_TIMERS);
	route(RELAY);
}

# Phones get longer than the 5 s default to send their FIRST reply. At the 2026-11-17 morning
# peak the course's phones took up to 7.4 s (some 11-21 s) to answer our INVITE even with a 100
# Trying: with 5 s, Kamailio answered Asterisk 408 (the ARI app's "ring: leg ended" cause 18) and
# the call went on to voicemail while the phone was about to ring; its late 200 OK then reached
# a call that was gone (see reply_route). How long a phone RINGS is still the ARI app's ring
# timeout (20 s, Asterisk CANCELs); this only decides when a phone that never answered at all is
# given up. Also set on the peer edge (FROM_PEER), which delivers to phones connected there.
route[DEV_TIMERS] {
	t_set_fr(120000, {{ kamailio_device_fr_timer_ms | default(15000) }});
}

# Runs once per contact. $du is that contact's Path: the edge holding its connection, with the
# phone's real address in ;received.
branch_route[DEV_BRANCH] {
	$var(rcv) = "";
	if ($du != $null && $(du{uri.param,received}) != "") {
		$var(rcv) = $(du{uri.param,received}{s.unescape.param});
	}
	$var(tp) = "udp";
	if ($var(rcv) != "") {
		$var(tp) = $(var(rcv){uri.transport});
	} else if ($(ru{uri.transport}) != "") {
		$var(tp) = $(ru{uri.transport});
	}
	if ($var(tp) =~ "^wss?$") setbflag(FLB_WS);
	else if ($var(tp) =~ "^tls$") setbflag(FLB_TLS);
	# The phone registered from the platform's private network (its address in Path ;received):
	# private media address toward it, as in FROM_DEVICE.
	if ($var(rcv) != "" && !isbflagset(FLB_WS)) {
		$var(rh) = $(var(rcv){uri.host});
{% for entry in private_device_cidrs | default([]) %}
		if (is_in_subnet("$var(rh)", "{{ net(entry) }}")) setbflag(FLB_PRIV);
{% endfor %}
	}
	xlog("L_INFO", "devices: branch $T_branch_idx of $rU -> $ru via $du ($var(tp)) [ci=$ci]\n");

	if ($var(rcv) != "" && $(du{uri.host}) == "{{ private_ip }}") {
		# The phone is connected to THIS edge: send straight to it (drop our own Path route), from
		# the public socket.
		remove_hf("Route");
		$du = $var(rcv);
		route(SEND_PUBLIC);
	}
	# else: leave $du = peer edge; it delivers over its own connection (route FROM_PEER). That
	# goes out of the default (internal) socket.

	# Leg tag for in-dialog requests (hold/resume, transfer). They can't tell from their own
	# transport: with two edges a browser's re-INVITE reaches the anchoring edge over UDP.
	$avp(extra_id) = @via[1].branch + $T_branch_idx;
{% if MEDIA %}
	route(RTP_SET_RR);
{% endif %}
	if (isbflagset(FLB_WS)) {
		add_rr_param(";leg=staff_ws");
		record_route();
		if (!rtpengine_offer("via-branch=extra {{ F.ws.pbx_offer }}")) drop;
	} else if (isbflagset(FLB_TLS)) {
		add_rr_param(";leg=staff_tls");
		if (isbflagset(FLB_PRIV)) {
			add_rr_param(";pn=1");
			record_route();
			if (!rtpengine_offer("via-branch=extra {{ FP.tls.pbx_offer }}")) drop;
		} else {
			record_route();
			if (!rtpengine_offer("via-branch=extra {{ F.tls.pbx_offer }}")) drop;
		}
	} else {
		add_rr_param(";leg=staff_udp");
		if (isbflagset(FLB_PRIV)) {
			add_rr_param(";pn=1");
			record_route();
			if (!rtpengine_offer("via-branch=extra {{ FP.plain.pbx_offer }}")) drop;
		} else {
			record_route();
			if (!rtpengine_offer("via-branch=extra {{ F.plain.pbx_offer }}")) drop;
		}
	}
}

onreply_route[DEV_REPLY] {
	if ($rs >= 180) xlog("L_INFO", "devices: $rs $rr from $si for $tU [ci=$ci]\n");
	route(REPLY_ALIAS);
	if (has_body("application/sdp")) {
		$avp(extra_id) = @via[2].branch + $T_branch_idx;
		route(G723_FIX);
		if (isbflagset(FLB_WS)) {
			rtpengine_answer("via-branch=extra {{ F.ws.pbx_answer }}$var(g723fix)");
		} else if (isbflagset(FLB_TLS)) {
			rtpengine_answer("via-branch=extra {{ F.tls.pbx_answer }}$var(g723fix)");
		} else {
			rtpengine_answer("via-branch=extra {{ F.plain.pbx_answer }}$var(g723fix)");
		}
	}
}

# rtpengine 26.0.1 bug (2026-11-15, Allen Computer Repair): a phone answering G.723 with ANY
# a=fmtp:4 line (e.g. "annexa=no") plus telephone-event got an answer toward Asterisk with NO audio
# codec ("m=audio ... 101"): Asterisk logged "No joint capabilities ... incoming SDP((nothing))"
# and sent nothing, and rtpengine sent the phone PCMU it can't play. Both parties heard silence.
# Adding reuse-codecs to that answer makes rtpengine keep PCMU toward Asterisk and transcode to
# G.723 toward the phone (tested at the media level, DTMF included). Only answers carrying a G.723
# fmtp line get the flag: reuse-codecs drops telephone-event toward Asterisk for Opus answers.
route[G723_FIX] {
	$var(g723fix) = "";
	if (search_body("a=fmtp:4 ")) {
		$var(g723fix) = " reuse-codecs";
	}
}

failure_route[DEV_FAILURE] {
	if (t_is_canceled()) {
		xlog("L_INFO", "devices: fork for $rU canceled (answered elsewhere or caller hung up) [ci=$ci]\n");
		exit;
	}
	xlog("L_INFO", "devices: every branch of $rU failed, best reply $T_reply_code [ci=$ci]\n");
	rtpengine_delete();
}

# A reply straight from a phone (not relayed by a peer edge, which already did this): remember
# its real address on the Contact so Asterisk's in-dialog requests reach it.
route[REPLY_ALIAS] {
{% for ip in edge_peer_ips %}
	if ($si == "{{ ip }}") return;
{% endfor %}
	if (proto == WS || proto == WSS || proto == TLS || nat_uac_test("19")) {
		add_contact_alias();
	}
}

# ---------------------------------------------------------------------------------------------
# Peer edge relaying an INVITE because the phone's connection lives on this node.
# The peer already engaged rtpengine; we only deliver.
# ---------------------------------------------------------------------------------------------
route[FROM_PEER] {
	# The INVITE carries OUR Path as a pre-loaded Route: <sip:{{ private_ip }}:5070;lr;received=...>.
	# Don't use loose_route() for it: on an initial request with a pre-loaded route it returns -3
	# ("next hop is taken from a preloaded route set", rr module docs), which `if (!...)` reads as
	# false, so every relayed call was refused with 403 (seen live 2026-11-14: every call to a
	# phone registered through edge-2 failed). Take the phone's address from ;received ourselves,
	# as DEV_BRANCH does on the sending edge.
	if (!is_present_hf("Route")) {
		xlog("L_WARN", "devices: relay from the peer edge without a Route, 403 [ci=$ci]\n");
		sl_send_reply("403", "Forbidden");
		exit;
	}
	$var(rt) = $(hdr(Route){nameaddr.uri});
	$var(rcv) = $(var(rt){uri.param,received}{s.unescape.param});
	if ($(var(rt){uri.host}) != "{{ private_ip }}" || $var(rcv) == $null || $var(rcv) == "") {
		xlog("L_WARN", "devices: relay from the peer edge with a Route that isn't our Path ($hdr(Route)), 403 [ci=$ci]\n");
		sl_send_reply("403", "Forbidden");
		exit;
	}
	remove_hf("Route");
	$du = $var(rcv);
	xlog("L_INFO", "devices: relaying for the peer edge to $du [ci=$ci]\n");
{% if MEDIA %}
	# Copy the sending edge's set into our own Record-Route, so the BYE we relay later deletes the
	# session in the right set (as before the sets: both edges send it, the second is a no-op).
	if (search("^Record-Route:.*;rs=1")) add_rr_param(";rs=1");
{% endif %}
	record_route();
	t_on_reply("PEER_REPLY");
	route(DEV_TIMERS);
	route(SEND_PUBLIC);
	route(RELAY);
}

onreply_route[PEER_REPLY] {
	if (proto == WS || proto == WSS || proto == TLS || nat_uac_test("19")) {
		add_contact_alias();
	}
}

# ---------------------------------------------------------------------------------------------
# In-dialog requests (BYE, re-INVITE, REFER, NOTIFY, ACK for 2xx, ...)
# ---------------------------------------------------------------------------------------------
route[WITHINDLG] {
	if (!loose_route()) {
		if (is_method("ACK") && t_check_trans()) {
			route(RELAY);
		}
		sl_send_reply("404", "Not here");
		exit;
	}

	# Next hop is a NATed/WS/TLS client: restore its real address from the Contact ;alias.
	if (!isdsturiset()) {
		handle_ruri_alias();
	}
{% if MEDIA %}
	# The call's own rtpengine set, from OUR Record-Route entry (no tag = set 0, the edges).
	if (check_route_param("rs=1")) $avp(rtpset) = 1;
{% endif %}

	if (is_method("BYE")) {
		rtpengine_delete();
	} else if (is_method("INVITE|UPDATE") && has_body("application/sdp")) {
		route(INDLG_SDP);
	}
	route(RELAY);
}

# re-INVITE / UPDATE with SDP: hold (a=sendonly or a=inactive), resume (a=sendrecv), session
# refresh. Same flags as the initial offer/answer for that leg and direction. rtpengine passes the
# a=sendonly/recvonly/inactive attributes through; Asterisk turns them into ChannelHold/Unhold.
#
# check_route_param() looks at OUR Record-Route entry, so a peer edge that only relays (FROM_PEER,
# no leg param) does nothing here; the edge that anchored the media does the rtpengine work.
# "From Asterisk" = FLT_PBX; anything else (carrier, vendor, phone, a peer edge relaying a phone's
# request) is the far side.
route[INDLG_SDP] {
{% for leg, fs, fp in [('carrier', F.plain, None), ('vendor', F.plain, None), ('staff_udp', F.plain, FP.plain), ('staff_tls', F.tls, FP.tls), ('staff_ws', F.ws, None)] %}
	{% if not loop.first %}} else {% endif %}if (check_route_param("leg={{ leg }}")) {
		if (isflagset(FLT_PBX)) {
{% if fp %}
			# ;pn=1: the phone is on the private network (initial INVITE): keep its private address.
			if (check_route_param("pn=1")) rtpengine_offer("{{ fp.pbx_offer }}");
			else rtpengine_offer("{{ fs.pbx_offer }}");
{% else %}
			rtpengine_offer("{{ fs.pbx_offer }}");
{% endif %}
			$avp(rtp_answer) = "{{ fs.pbx_answer }}";
		} else {
{% if fp %}
			if (check_route_param("pn=1")) rtpengine_offer("{{ fp.far_offer }}");
			else rtpengine_offer("{{ fs.far_offer }}");
{% else %}
			rtpengine_offer("{{ fs.far_offer }}");
{% endif %}
			$avp(rtp_answer) = "{{ fs.far_answer }}";
		}
		t_on_reply("RTP_REPLY");
{% endfor %}
	}
}

# Generic answer handler: flags were chosen when the offer was sent (AVPs live in the transaction).
onreply_route[RTP_REPLY] {
	# Reply from a phone to Asterisk's re-INVITE: its Contact becomes Asterisk's new remote target,
	# so it needs the ;alias too (like DEV_REPLY).
	if (isflagset(FLT_PBX)) route(REPLY_ALIAS);
	if (has_body("application/sdp") && $avp(rtp_answer) != $null) {
		route(G723_FIX);
		rtpengine_answer("$avp(rtp_answer)$var(g723fix)");
	}
}

# ---------------------------------------------------------------------------------------------
# WebSocket handshake (HTTP Upgrade) from HAProxy
# ---------------------------------------------------------------------------------------------
event_route[xhttp:request] {
	set_reply_close();
	set_reply_no_connect();
	if ($Rp != {{ kamailio_ws_port }}) {
		xhttp_reply("403", "Forbidden", "", "");
		exit;
	}
	if ($hdr(Upgrade) =~ "websocket" && $hdr(Connection) =~ "Upgrade" && $rm =~ "GET") {
		if (ws_handle_handshake()) {
			exit;
		}
	}
	xhttp_reply("404", "Not Found", "", "");
}
