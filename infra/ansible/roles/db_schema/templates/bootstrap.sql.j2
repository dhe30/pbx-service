-- Roles, database and schemas. Idempotent; runs as the postgres superuser on every deploy.
\set ON_ERROR_STOP on

DO $$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{{ db_app_user }}') THEN
    CREATE ROLE {{ db_app_user }} LOGIN;
  END IF;
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{{ db_kamailio_user }}') THEN
    CREATE ROLE {{ db_kamailio_user }} LOGIN;
  END IF;
END $$;

ALTER ROLE {{ db_app_user }} PASSWORD '{{ vault_db_app_password }}';
ALTER ROLE {{ db_kamailio_user }} PASSWORD '{{ vault_db_kamailio_password }}';
-- Kamailio uses unqualified table names (subscriber, location, version): find them in its schema.
ALTER ROLE {{ db_kamailio_user }} SET search_path = kamailio;

SELECT 'CREATE DATABASE {{ db_name }} OWNER {{ db_app_user }}'
 WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '{{ db_name }}')\gexec

\connect {{ db_name }}

CREATE SCHEMA IF NOT EXISTS kamailio AUTHORIZATION {{ db_kamailio_user }};

-- The API manages staff SIP accounts by writing kamailio.subscriber; the ARI app never needs it,
-- but sharing one app role keeps things simple for now.
GRANT USAGE ON SCHEMA kamailio TO {{ db_app_user }};
ALTER DEFAULT PRIVILEGES FOR ROLE {{ db_kamailio_user }} IN SCHEMA kamailio
  GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO {{ db_app_user }};
ALTER DEFAULT PRIVILEGES FOR ROLE {{ db_kamailio_user }} IN SCHEMA kamailio
  GRANT USAGE, SELECT ON SEQUENCES TO {{ db_app_user }};
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA kamailio TO {{ db_app_user }};
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA kamailio TO {{ db_app_user }};
