# Managed by Ansible. Read by pbx-api.service; see services/api/src/config.ts.
NODE_ENV=production
LOG_LEVEL={{ api_log_level }}
# Private IP only: the edge HAProxies are the only clients (host firewall: cluster only).
HOST={{ private_ip }}
PORT={{ api_port }}

# Local DB proxy -> current Patroni primary (CLAUDE.md §4.3 #7).
DATABASE_URL={{ app_db_url }}
DB_POOL_MAX={{ api_db_pool_max }}

S3_ENDPOINT={{ s3_endpoint }}
S3_REGION={{ s3_region }}
S3_BUCKET={{ s3_bucket }}
S3_ACCESS_KEY_ID={{ vault_s3_access_key }}
S3_SECRET_ACCESS_KEY={{ vault_s3_secret_key }}
FFMPEG_PATH=/usr/bin/ffmpeg

# Identical on every app node, or logins break when HAProxy switches replicas.
JWT_SECRET={{ vault_jwt_secret }}
COOKIE_SECURE=true

STRIPE_API_URL={{ stripe_api_url }}
STRIPE_JS_URL={{ stripe_js_url }}
STRIPE_SECRET_KEY={{ vault_stripe_secret_key }}
STRIPE_PUBLISHABLE_KEY={{ vault_stripe_publishable_key }}

DID_PROVIDER_MODE=didww
DID_PROVIDER_URL={{ did_provider_url }}
DID_PROVIDER_API_KEY={{ vault_did_api_key }}
{% if did_trunk_group_id %}
DID_TRUNK_GROUP_ID={{ did_trunk_group_id }}
{% else %}
DID_TRUNK_ID={{ did_trunk_id }}
{% endif %}

# Softphone: SIP over WebSocket through the edge HAProxy (path /ws), same origin as the API.
SIP_WS_URI=wss://{{ web_domain }}/ws
SIP_DOMAIN={{ sip_domain }}

SHUTDOWN_DRAIN_MS={{ api_shutdown_drain_ms }}
SHUTDOWN_TIMEOUT_MS=10000
