# Garage config. Reference: https://garagehq.deuxfleurs.fr/documentation/reference-manual/configuration/
metadata_dir = "/var/lib/garage/meta"
{% if garage_volume_data_dir %}
# New blocks go to the Volume; the root-disk dir stays readable (read_only: no new blocks there).
# Garage moves old blocks over with `garage repair rebalance`. Removing the Volume entry would
# make every block on it invisible: keep this list as it is once data was written.
data_dir = [
  { path = "/var/lib/garage/data", read_only = true },
  { path = "{{ garage_volume_data_dir }}", capacity = "{{ garage_volume_capacity }}" },
]
{% else %}
data_dir = "/var/lib/garage/data"
{% endif %}
db_engine = "lmdb"

# Copies of every object. 1 on the all-in-one VM, 3 across db-1..3.
replication_factor = {{ garage_replication_factor }}

# Node-to-node RPC (private network only).
rpc_bind_addr = "{{ private_ip }}:3901"
rpc_public_addr = "{{ private_ip }}:3901"
rpc_secret = "{{ vault_garage_rpc_secret }}"

[s3_api]
s3_region = "{{ s3_region }}"
api_bind_addr = "{{ private_ip }}:{{ s3_port }}"
root_domain = ".s3.pbx.internal"

# Admin API: on the private IP so Prometheus on mon-1 can read /metrics (host firewall: cluster
# nodes only). No admin_token is set, so the admin endpoints themselves stay disabled; only
# /metrics and /health answer.
[admin]
api_bind_addr = "{{ private_ip }}:3903"
