# Managed by Ansible. Read by pbx-ari-app.service; see services/ari-app/src/config.ts.
NODE_ENV=production
LOG_LEVEL=info
PBX_NODE={{ inventory_hostname }}

ARI_URL=http://127.0.0.1:8088
ARI_USER={{ ari_user }}
ARI_PASSWORD={{ vault_ari_password }}
ARI_APP=pbx-app

DATABASE_URL={{ app_db_url }}

S3_ENDPOINT={{ s3_endpoint }}
S3_REGION={{ s3_region }}
S3_BUCKET={{ s3_bucket }}
S3_ACCESS_KEY_ID={{ vault_s3_access_key }}
S3_SECRET_ACCESS_KEY={{ vault_s3_secret_key }}

# PJSIP trunks toward the Kamailio edges, in preference order.
TRUNKS={{ edge_trunk_names | join(',') }}

SPOOL_DIR=/var/spool/asterisk/recording
SOUNDS_CACHE_DIR=/var/lib/asterisk/sounds/cache
HEALTH_HOST=127.0.0.1
HEALTH_PORT=9101

# PSTN vendors (course spec §1): legs go Asterisk -> Kamailio edge -> vendor.
VENDOR_US_HOST={{ vendor_us_host }}
VENDOR_INTL_HOST={{ vendor_intl_host }}
VENDOR_NUMBER_FORMAT={{ vendor_number_format }}

# Durable CDR queue (B6): one file per finished leg until it's in Postgres.
CDR_SPOOL_DIR=/var/spool/pbx/cdr
CDR_FLUSH_MS=250
CONFIG_TTL_SEC=30
DB_POOL_MAX=10
