# Grafana settings (managed by Ansible, roles/monitoring). GF_<SECTION>_<KEY> overrides grafana.ini.
# Contains a secret (admin password).
GF_SERVER_HTTP_ADDR={{ private_ip }}
GF_SERVER_HTTP_PORT={{ grafana_port }}
# Applied only when Grafana creates its database (first start); later changes: Grafana UI.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}
GF_USERS_ALLOW_SIGN_UP=false
# No calls home to grafana.com.
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
