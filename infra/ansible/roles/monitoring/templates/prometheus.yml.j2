# Prometheus config for {{ inventory_hostname }} (managed by Ansible, roles/monitoring).
# Targets come from the inventory groups: add a host to the inventory, rerun the playbook for mon,
# and it is watched. The `instance` label is the inventory host name (edge-1, db-2, ...), so alerts
# say "db-2" instead of an IP.
{#
  scrape(hosts, port): one static target per inventory host, on its private IP.
#}
{% macro scrape(hosts, port) %}
    static_configs:
{% for host in hosts %}
      - targets: ["{{ hostvars[host].private_ip }}:{{ port }}"]
        labels: { instance: "{{ host }}" }
{% endfor %}
{% endmacro %}
{% set mon_hosts = groups.get('mon', []) %}
{% set db_hosts = groups.get('db', []) %}
{% set edge_hosts = groups.get('edge', []) %}
{% set app_hosts = groups.get('app', []) %}
{% set rtpengine_hosts = groups.get('media') or edge_hosts %}
{# Hosts running the local DB proxy + its metrics gateway (roles/db_local_proxy). A host that is
   also a db node (all-in-one VM) has no local proxy. #}
{% set proxy_hosts = groups.get('db_clients', []) | reject('in', db_hosts) | list %}
{% set gateway_pbx_hosts = groups.get('pbx', []) | select('in', proxy_hosts) | list %}
{% set gateway_port = dbproxy_metrics_port | default(9200) %}
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["{{ private_ip }}:{{ alertmanager_port }}"]

scrape_configs:
  # Every VM: CPU, memory, disk, network, boot time, systemd units (node_exporter, roles/common).
  - job_name: node
{{ scrape(groups['all'], node_exporter_port) }}

  # The monitoring stack itself.
  - job_name: prometheus
{{ scrape(mon_hosts, prometheus_port) }}

  - job_name: alertmanager
{{ scrape(mon_hosts, alertmanager_port) }}
{% if db_hosts %}

  # Data tier (Track 1): Patroni says who is primary and how far replicas lag; etcd is the vote
  # Patroni relies on.
  - job_name: patroni
{{ scrape(db_hosts, patroni_restapi_port | default(8008)) }}

  - job_name: etcd
{{ scrape(db_hosts, etcd_client_port | default(2379)) }}

  # Postgres internals (roles/postgres_exporter) on every db node: connections, transactions,
  # cache hits, locks, long transactions, and the most expensive queries (pg_stat_statements).
  - job_name: postgres
{{ scrape(db_hosts, postgres_exporter_port | default(9187)) }}
{% endif %}
{% if rtpengine_hosts %}

  # Media relay + transcoding: sessions, packet rates, errors.
  - job_name: rtpengine
{{ scrape(rtpengine_hosts, 2225) }}
{% endif %}
{% if edge_hosts %}

  # Edge HAProxy (HTTPS/WSS in front of the API and Kamailio WS): backend health, request rates.
  - job_name: edge_haproxy
{{ scrape(edge_hosts, 8404) }}
{% endif %}
{% if app_hosts %}

  # API: request latency histogram (pbx_api_http_request_duration_seconds) + Node.js process stats.
  - job_name: api
{{ scrape(app_hosts, api_port | default(3000)) }}
{% endif %}
{% if db_hosts %}

  # Garage (S3 object store): cluster health, connected nodes, request rates and errors.
  - job_name: garage
{{ scrape(db_hosts, 3903) }}
{% endif %}
{% if proxy_hosts %}

  # The local DB/S3 proxy on every client node: which db node is primary/replica as THIS node
  # sees it, connection counts, S3 backends. Read through the metrics gateway.
  - job_name: dbproxy
    metrics_path: /metrics/proxy
{{ scrape(proxy_hosts, gateway_port) }}
{% endif %}
{% if gateway_pbx_hosts %}

  # Call control (services/ari-app): active calls, finished legs by outcome, CDR/upload backlogs,
  # vendor failures. Loopback-only on the pbx node; read through the metrics gateway.
  - job_name: ari_app
    metrics_path: /metrics/ari
{{ scrape(gateway_pbx_hosts, gateway_port) }}

  # Asterisk (res_prometheus): channels, bridges, endpoints. Same gateway.
  - job_name: asterisk
    metrics_path: /metrics/asterisk
{{ scrape(gateway_pbx_hosts, gateway_port) }}
{% endif %}

{% if edge_hosts %}
{#
  Probes through the blackbox exporter on this host: Prometheus asks it to probe each edge
  (target = the address the edge's HAProxy/Kamailio listen on: the private IP behind Clanode's
  1:1 NAT, else the public IP). Results: probe_success, probe_duration_seconds,
  probe_ssl_earliest_cert_expiry. instance = the edge's inventory name.
#}
{% set probes = [
     {'job': 'probe_api', 'module': 'pbx_api', 'what': 'API through the edge (GET /ready)'},
     {'job': 'probe_web', 'module': 'pbx_web', 'what': 'website (GET / as a browser)'},
     {'job': 'probe_sip_tls', 'module': 'pbx_sip_tls', 'what': 'SIP over TLS handshake'},
   ] %}
{% for p in probes %}

  # Blackbox: {{ p.what }} on every edge.
  - job_name: {{ p.job }}
    metrics_path: /probe
    params:
      module: [{{ p.module }}]
    static_configs:
{% for host in edge_hosts %}
{% set ip = hostvars[host].public_bind_ip %}
{% if p.job == 'probe_api' %}
      - targets: ["https://{{ ip }}/ready"]
{% elif p.job == 'probe_web' %}
      - targets: ["https://{{ ip }}/"]
{% else %}
      - targets: ["{{ ip }}:{{ kamailio_tls_port | default(5061) }}"]
{% endif %}
        labels: { instance: "{{ host }}" }
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - target_label: __address__
        replacement: "{{ private_ip }}:{{ blackbox_port }}"
{% endfor %}
{% endif %}

# Not scraped yet: Kamailio (no metrics endpoint).
