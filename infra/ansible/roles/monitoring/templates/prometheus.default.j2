# Prometheus options (managed by Ansible, roles/monitoring). Read by Debian's systemd unit.
# Private IP only; old data is deleted after {{ prometheus_retention_time }} or once it exceeds {{ prometheus_retention_size }}.
ARGS="--web.listen-address={{ private_ip }}:{{ prometheus_port }} --storage.tsdb.retention.time={{ prometheus_retention_time }} --storage.tsdb.retention.size={{ prometheus_retention_size }}"
