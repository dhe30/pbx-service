      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(haproxy_backend_current_sessions{job=\"edge_haproxy\",proxy=\"kamailio_ws\"})",
          "legendFormat": ""
