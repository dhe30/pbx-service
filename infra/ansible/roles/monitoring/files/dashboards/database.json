    {
      "id": 11,
      "type": "timeseries",
      "title": "Cache hit share",
      "description": "Below ~0.99 = reads go to disk: more memory (shared_buffers) or better indexes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (rate(pg_stat_database_blks_hit{datname=\"pbx\"}[$__rate_interval])) / (sum by (instance) (rate(pg_stat_database_blks_hit{datname=\"pbx\"}[$__rate_interval])) + sum by (instance) (rate(pg_stat_database_blks_read{datname=\"pbx\"}[$__rate_interval])))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Most expensive statements: seconds spent per second over the last 5 min (top 10)",
      "description": "Look a queryid up on that db node: SELECT query, calls, mean_exec_time FROM pg_stat_statements WHERE queryid = <id>;",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, sum by (instance, queryid) (rate(pg_stat_statements_seconds_total[5m])))",
          "format": "table",
          "instant": true
        }
      ]
    },
