      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (rate(pg_stat_database_xact_commit{datname=\"pbx\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} commits"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (rate(pg_stat_database_xact_rollback{datname=\"pbx\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} rollbacks"
        }
      ]
    },
