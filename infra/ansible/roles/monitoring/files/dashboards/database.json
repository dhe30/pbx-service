      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - pbx_backup_last_success_timestamp_seconds",
          "legendFormat": ""
        }
      ]
    },
    {
