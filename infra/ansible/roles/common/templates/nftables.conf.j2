#!/usr/sbin/nft -f
# Host firewall (CLAUDE.md §14). The cloud firewall can't filter by source, so this is where
# "private services only from our own nodes" is enforced.
flush ruleset

table inet filter {
	# Private IPs of every node in the inventory.
	set cluster {
		type ipv4_addr
		elements = { {{ groups['all'] | map('extract', hostvars, 'private_ip') | select('defined') | unique | join(', ') }} }
	}

	chain input {
		type filter hook input priority 0; policy drop;

		ct state established,related accept
		ct state invalid drop
		iif lo accept
		ip protocol icmp accept
		meta l4proto ipv6-icmp accept

		tcp dport 22 accept

		# Internal services (Postgres, Kamailio WS, rtpengine ng, Asterisk SIP/RTP, Garage, ...)
		# are reachable only from our own nodes. Per-port rules come with the multi-VM split.
		ip saddr @cluster accept
{% if inventory_hostname in groups['edge'] %}

		# Edge: public SIP (UDP + TLS for _sips._tcp phones), HTTPS/WSS, and rtpengine media.
		udp dport 5060 accept
		tcp dport {{ kamailio_tls_port | default(5061) }} accept
		# HTTP: Let's Encrypt HTTP-01 challenges; everything else is redirected to HTTPS.
		tcp dport 80 accept
		tcp dport 443 accept
		udp dport 30000-40000 accept
{% endif %}
{% if groups.get('media') and inventory_hostname in groups['media'] %}

		# Dedicated media node: rtpengine media.
		udp dport 30000-40000 accept
{% endif %}
{% set test_peers = ((groups.get('edge', []) + groups.get('media', [])) | map('extract', hostvars) | selectattr('public_ip', 'defined') | map(attribute='public_ip') | unique | list) %}
{% if inventory_hostname in groups.get('mon', []) and test_peers %}

		# mon-1's test phones (synthetic call, quality test, long-call test) register and call
		# through the edges' PUBLIC addresses, so Kamailio's SIP and rtpengine's RTP come back from
		# those addresses, which are not in @cluster. Without this they only got in while conntrack
		# still had the flow (UDP: ~2 min after mon-1's last packet on it): a long call's SIP is idle
		# for 15 min, and Asterisk's session refresh at 900 s was dropped here (2026-11-15,
		# docs/incidents/2026-11-14-codec-flip.md follow-up 2). Test SIP ports 5090-5099, media 6100-6499.
		ip saddr { {{ test_peers | join(', ') }} } udp dport { 5090-5099, 6100-6499 } accept
{% endif %}
	}

	chain forward {
		type filter hook forward priority 0; policy drop;
	}

	chain output {
		type filter hook output priority 0; policy accept;
	}
}
