#!/usr/sbin/nft -f
# Host firewall (CLAUDE.md §14). The cloud firewall can't filter by source, so this is where
# "private services only from our own nodes" is enforced.
flush ruleset

table inet filter {
	# Private IPs of every node in the inventory.
	set cluster {
		type ipv4_addr
		elements = { {{ groups['all'] | map('extract', hostvars, 'private_ip') | select('defined') | unique | join(', ') }} }
	}

	chain input {
		type filter hook input priority 0; policy drop;

		ct state established,related accept
		ct state invalid drop
		iif lo accept
		ip protocol icmp accept
		meta l4proto ipv6-icmp accept

		tcp dport 22 accept

		# Internal services (Postgres, Kamailio WS, rtpengine ng, Asterisk SIP/RTP, Garage, ...)
		# are reachable only from our own nodes. Per-port rules come with the multi-VM split.
		ip saddr @cluster accept
{% if inventory_hostname in groups['edge'] %}

		# Edge: public SIP, HTTPS/WSS, and rtpengine media.
		udp dport 5060 accept
		tcp dport 443 accept
		udp dport 30000-40000 accept
{% endif %}
	}

	chain forward {
		type filter hook forward priority 0; policy drop;
	}

	chain output {
		type filter hook output priority 0; policy accept;
	}
}
