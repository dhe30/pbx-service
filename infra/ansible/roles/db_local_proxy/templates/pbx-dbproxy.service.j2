[Unit]
Description=Local DB/S3 proxy (HAProxy): Patroni primary, replicas, Garage
After=network-online.target
Wants=network-online.target

[Service]
Environment="CONFIG=/etc/haproxy/dbproxy.cfg" "PIDFILE=/run/pbx-dbproxy/haproxy.pid"
ExecStartPre=/usr/sbin/haproxy -f $CONFIG -c -q
ExecStart=/usr/sbin/haproxy -Ws -f $CONFIG -p $PIDFILE
ExecReload=/usr/sbin/haproxy -f $CONFIG -c -q
ExecReload=/bin/kill -USR2 $MAINPID
KillMode=mixed
Restart=always
RestartSec=2
Type=notify
RuntimeDirectory=pbx-dbproxy

[Install]
WantedBy=multi-user.target
