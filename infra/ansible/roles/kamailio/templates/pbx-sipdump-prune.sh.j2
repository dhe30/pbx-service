#!/bin/sh
# Managed by Ansible (role kamailio). Hourly cleanup of the SIP history (kamailio.cfg sipdump),
# run by pbx-sipdump-prune.timer. Needs no Kamailio restart, unlike sipdump's own fage.
#   0. compress every closed hour with zstd -1 (sip-*.pcap -> sip-*.pcap.zst)
#   1. delete files older than {{ kamailio_sipdump_keep_hours }} h
#   2. while the folder is over {{ kamailio_sipdump_max_gb }} GB, delete the oldest hour (pcap + meta)
# The newest pcap is the one sipdump is writing: never compressed or deleted.
# 2026-11-22: edge-2 reached 69 % (18 GB of pcaps, ~0.9 GB/h, 95 % REGISTER + DMQ).
# 2026-11-27: edge-2 wrote up to 5.3 GB an hour, so the 10 GB cap kept only 1-2 hours. zstd -1 makes
# a closed hour ~11x smaller for ~0.3 s of CPU per 100 MB (measured on both edges), run at the lowest
# CPU and I/O priority; loadtest/diag/sip-history.py reads the .zst files directly.
set -eu

dir='{{ kamailio_sipdump_dir }}'
keep_min={{ kamailio_sipdump_keep_hours * 60 }}
max_kb={{ kamailio_sipdump_max_gb * 1024 * 1024 }}

[ -d "$dir" ] || exit 0
newest=$(ls -t "$dir"/sip-*.pcap 2>/dev/null | head -n 1)

# 0. compress closed hours (zstd keeps the file's time, so step 1 still ages it correctly)
if command -v zstd >/dev/null 2>&1; then
  for f in "$dir"/sip-*.pcap; do
    [ -f "$f" ] || continue
    [ "$f" = "$newest" ] && continue
    nice -n 19 zstd -1 -T1 -q --rm -- "$f" || echo "zstd failed on $f (left as is)"
  done
fi

# 1. age
find "$dir" -maxdepth 1 -type f -name 'sip-*' -mmin +"$keep_min" ! -path "${newest:-/nonexistent}" -delete

# 2. size cap, oldest first
while [ "$(du -sk "$dir" | cut -f1)" -gt "$max_kb" ]; do
  oldest=$(ls -tr "$dir"/sip-*.pcap "$dir"/sip-*.pcap.zst 2>/dev/null | head -n 1)
  if [ -z "$oldest" ] || [ "$oldest" = "$newest" ]; then
    break
  fi
  echo "over ${max_kb} KB: deleting $oldest"
  base=${oldest%.zst}
  rm -f -- "$oldest" "${base%.pcap}.meta"
done
