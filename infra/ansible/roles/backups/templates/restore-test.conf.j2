# pgBackRest config for the restore test only (managed by Ansible, roles/backups): the same
# repository, but restored into a local scratch directory on {{ inventory_hostname }}.
[global]
repo1-path={{ backup_repo_path }}
# Own scratch directory: the package's /var/spool/pgbackrest belongs to postgres, and this
# test runs as pgbackrest (restore and the restored server's archive-get both use it).
spool-path={{ backup_restore_test_dir }}/spool
log-path=/var/log/pgbackrest
log-level-console=info
log-level-file=info

[{{ pgbackrest_stanza }}]
pg1-path={{ backup_restore_test_dir }}/data
