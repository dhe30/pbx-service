# HAProxy on edge nodes: the only public HTTPS/WSS entry point (CLAUDE.md §4.2).
#   /ws          -> Kamailio WebSocket (browsers' SIP)
#   /webrtc-test -> static WebRTC test page (phase 1 only)
#   /api/...     -> API, "/api" stripped (the website's calls; cookie Path /auth -> /api/auth)
#   /, /assets/..., favicons, page loads (GET/HEAD with Accept: text/html) -> website (role web)
#   everything else -> API at the root (the course's tools: /openapi.json has no `servers`, so
#                      they call https://<domain>/numbers, /auth/login, ...)
# Port 80: Let's Encrypt HTTP-01 challenges -> local certbot; everything else -> HTTPS.
global
    log /dev/log local0
    maxconn 20000
    # The test page is served from memory by "http-request return"; it must fit in one buffer.
    tune.bufsize 32768
    ssl-default-bind-options ssl-min-ver TLSv1.2
    stats socket /run/haproxy/admin.sock mode 660 level admin

defaults
    mode http
    log global
    option httplog
    option dontlognull
    timeout connect 5s
    timeout client 60s
    timeout server 60s
    # WebSocket connections are long-lived; Kamailio pings every 30 s.
    timeout tunnel 1h

frontend http
    bind {{ public_bind_ip }}:80
    # certbot (standalone) answers HTTP-01 challenges on 127.0.0.1 while it issues or renews
    # (acme_edge only; elsewhere nothing listens there and these requests get a 503).
    acl acme_challenge path_beg /.well-known/acme-challenge/
    http-request redirect scheme https code 301 unless acme_challenge
    use_backend acme if acme_challenge

backend acme
    server certbot 127.0.0.1:{{ acme_http_port | default(8888) }}

frontend https
    # HTTP/1.1 only: Kamailio doesn't speak WebSocket over HTTP/2.
    bind {{ public_bind_ip }}:443 ssl crt /etc/haproxy/certs/site.pem alpn http/1.1
    http-request return status 200 content-type "text/html; charset=utf-8" file /etc/haproxy/www/webrtc-test.html hdr cache-control no-store if { path /webrtc-test }

    # One origin for the website, its API calls and the course's tools (split-contracts O4).
    # The website calls /api/... (services/web baseURL), the tools call the API at the root, and
    # page URLs (/numbers, /calls, ...) are the same paths as API routes: a browser loading a page
    # asks for text/html, an API client doesn't.
    acl api_prefix path_beg /api/
    acl web_static path_beg /assets/
    acl web_files  path / /index.html /favicon.ico /favicon.svg /vite.svg /robots.txt
    acl api_only   path /openapi.json /health /ready /metrics
    acl page_load  method GET HEAD
    acl wants_html req.hdr(accept) -m sub text/html
    # Remember the prefix BEFORE stripping it: afterwards /api/ would look like / (a web path).
    http-request set-var(txn.api_prefix) bool(true) if api_prefix
    http-request replace-path ^/api(/.*)$ \1 if api_prefix

    use_backend kamailio_ws if { path /ws }
    use_backend api if { var(txn.api_prefix) -m bool }
    use_backend web if web_static || web_files
    use_backend web if page_load wants_html !api_only
    default_backend api

backend kamailio_ws
    # Local Kamailio first; peers only if it's down. Either way the registration's Path points at
    # whichever Kamailio holds this connection, so calls still reach the browser.
    server kam-local {{ private_ip }}:{{ kamailio_ws_port }} check
{% for ip in edge_peer_ips %}
    server kam-peer{{ loop.index }} {{ ip }}:{{ kamailio_ws_port }} check backup
{% endfor %}

backend api
    # /ready (not /health): it turns 503 as soon as an API process gets SIGTERM (deploys run
    # serial: 1), so this edge stops sending it requests before it closes (SHUTDOWN_DRAIN_MS 6 s >
    # inter 2s x fall 2). Trade-off (backend-for-team.md): if the database is down cluster-wide,
    # every API node is marked down and HAProxy answers 503 itself, which clients retry the same way.
    option httpchk GET /ready
    http-check expect status 200
    default-server inter 2s fall 2 rise 2
    # Retry another app node when a connection fails (node died between checks).
    retries 2
    option redispatch
    # Lost SYNs on the private network (2026-11-13, edge-1 HAProxy logs: 47 of 6021 API requests had
    # Tc ~1000 ms = the kernel's 1 s SYN retransmit, while the API itself answered in 5-10 ms). The
    # app nodes are one private hop away (connect < 5 ms at p99), so give up on a connect after
    # 250 ms and retry at once (retries 2; the last one goes to the other node): a lost SYN costs
    # ~0.25 s instead of 1 s (or 3 s if lost twice). The kernel finishes the handshake even when Node
    # is busy, so a slow API never trips this.
    timeout connect 250ms
    # Keep server connections open and share them between clients (the API is stateless: cookies
    # travel with each request), so most requests need no new connection at all. Fastify's
    # keepAliveTimeout (72 s) is longer than HAProxy's idle-pool purge, so the API never closes an
    # idle connection that HAProxy is about to reuse.
    http-reuse always
    # The website reaches the API under /api, but the refresh cookie is scoped Path=/auth
    # (services/api/src/auth.ts): rewrite it to /api/auth on those responses, or the browser
    # never sends it back to /api/auth/refresh. (The access cookie is Path=/: fine as is.)
    http-response replace-header Set-Cookie ^(.*;\s*[Pp]ath=)/auth(;.*)?$ \1/api/auth\2 if { var(txn.api_prefix) -m bool }
{% for host in groups['app'] | default([]) %}
    server {{ host }} {{ hostvars[host].private_ip }}:{{ api_port | default(3000) }} check
{% endfor %}

backend web
    # Static build of services/web on every app node (nginx, role web).
    option httpchk GET /
    http-check expect status 200
    default-server inter 2s fall 2 rise 2
    retries 2
    option redispatch
    # Same lost-SYN protection and connection reuse as backend api.
    timeout connect 250ms
    http-reuse always
{% for host in groups['app'] | default([]) %}
    server {{ host }}-web {{ hostvars[host].private_ip }}:{{ web_port | default(8081) }} check
{% endfor %}

# Local stats + Prometheus metrics (private IP only).
frontend stats
    bind {{ private_ip }}:8404
    http-request use-service prometheus-exporter if { path /metrics }
    stats enable
    stats uri /stats
