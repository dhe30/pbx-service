vault_ari_password: 34805994b7e346ccae0151a7a16d6a38d67ebeefe7b0bab8

# Garage: rpc secret must be exactly 32 bytes hex:   openssl rand -hex 32
vault_garage_rpc_secret: f89ec329b5790672d95eb6b9e84f2207d2e8995cfaa5715c84f5065b77722cef
# S3 key imported into Garage. Format is fixed by Garage:
#   access key = "GK" + 24 hex chars:  echo GK$(openssl rand -hex 12)
#   secret     = 64 hex chars:         openssl rand -hex 32
vault_s3_access_key: GK7c242abd269f788588aef585
vault_s3_secret_key: 214040ebe7680d848c1f25287d4b103f80300da9f60ad75e29e4767adbef39fe

# SIP passwords for the seeded test staff (alice = browser, bob = UDP phone / SIPp).
