# Every key group_vars/all/vault.yml must have, with its format. Don't copy this file: generate a
# vault with fresh random values instead (this repo is public, so any value written here is known):
#
#   infra/ansible/scripts/new-vault.sh            # writes group_vars/all/vault.yml
#   (fill in the CHANGE_ME values from the Course Services tab)
#   ansible-vault encrypt infra/ansible/group_vars/all/vault.yml
#
# One vault per deployment, shared by everyone who deploys it (see the script's header).

# Postgres users of the app and of Kamailio; ARI. Format: openssl rand -hex 24
vault_db_app_password: GENERATED
vault_db_kamailio_password: GENERATED
vault_ari_password: GENERATED

# Patroni cluster (db hosts): Postgres superuser, streaming replication user, pg_rewind user.
vault_db_superuser_password: GENERATED
vault_db_replication_password: GENERATED
vault_db_rewind_password: GENERATED

# Garage: rpc secret must be exactly 32 bytes hex:   openssl rand -hex 32
vault_garage_rpc_secret: GENERATED
# S3 key imported into Garage. Format is fixed by Garage:
#   access key = "GK" + 24 hex chars:  echo GK$(openssl rand -hex 12)
#   secret     = 64 hex chars:         openssl rand -hex 32
vault_s3_access_key: GENERATED
vault_s3_secret_key: GENERATED

# API (app nodes). JWT secret: identical on every app node, at least 16 chars: openssl rand -hex 32
vault_jwt_secret: GENERATED

# SIP passwords for the seeded test staff (alice = browser, bob = UDP phone / SIPp). Port 5060 is
# public and these accounts can place billed vendor calls: keep them random.
vault_test_alice_password: GENERATED
vault_test_bob_password: GENERATED

# PSTN vendor digest credentials (Course Services tab -> US / International PSTN vendor).
# On the local VM any placeholder works (the vendors are unreachable from there).
vault_vendor_us_user: CHANGE_ME
vault_vendor_us_password: CHANGE_ME
vault_vendor_intl_user: CHANGE_ME
vault_vendor_intl_password: CHANGE_ME

# DID provider (DIDWW clone) Api-Key, Course Services tab. Required by the api role.
vault_did_api_key: CHANGE_ME
# Payment gateway (Stripe clone) test-mode keys, Course Services tab. The publishable key is not
# secret (browsers get it) but comes from the same place. Required by the api role.
vault_stripe_secret_key: CHANGE_ME
vault_stripe_publishable_key: CHANGE_ME
# Provider (operator) token for GET /operator/tickets (every account's support tickets), at least
# 32 chars:  openssl rand -hex 32. Only the team uses it; never give it to a customer account.
vault_operator_token: CHANGE_ME_to_openssl_rand_hex_32

# Optional: contact address for Let's Encrypt expiry/problem mails (group_vars acme_email reads
# it). Empty or absent = register without an email. Here, not in main.yml: the repo is public.
vault_acme_email: ""

# Monitoring (mon-1). Grafana "admin" password (at least 12 chars). Format: openssl rand -hex 16
vault_grafana_admin_password: GENERATED
# Discord webhook for alerts (channel settings -> Integrations -> Webhooks -> Copy Webhook URL).
# Empty = no Discord messages; alerts are still shown in Grafana's Alerting pages.
vault_discord_webhook_url: ""
