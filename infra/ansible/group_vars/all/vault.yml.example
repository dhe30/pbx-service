# Copy to group_vars/all/vault.yml, fill in, then encrypt:
#   ansible-vault encrypt group_vars/all/vault.yml
# Generate values with:  openssl rand -hex 24
vault_db_app_password: c062f9cadd59f920b075c3841d465cb2ac2f5af2615c6f2b
vault_db_kamailio_password: fd602a362eeac911a110dcc1803f581cb116421f4d353972
vault_ari_password: 34805994b7e346ccae0151a7a16d6a38d67ebeefe7b0bab8

# Patroni cluster (db hosts): Postgres superuser, streaming replication user, pg_rewind user.
vault_db_superuser_password: CHANGE_ME
vault_db_replication_password: CHANGE_ME
vault_db_rewind_password: CHANGE_ME

# Garage: rpc secret must be exactly 32 bytes hex:   openssl rand -hex 32
vault_garage_rpc_secret: f89ec329b5790672d95eb6b9e84f2207d2e8995cfaa5715c84f5065b77722cef
# S3 key imported into Garage. Format is fixed by Garage:
#   access key = "GK" + 24 hex chars:  echo GK$(openssl rand -hex 12)
#   secret     = 64 hex chars:         openssl rand -hex 32
vault_s3_access_key: GK7c242abd269f788588aef585
vault_s3_secret_key: 214040ebe7680d848c1f25287d4b103f80300da9f60ad75e29e4767adbef39fe

# SIP passwords for the seeded test staff (alice = browser, bob = UDP phone / SIPp).
vault_test_alice_password: test123
vault_test_bob_password: test123

# PSTN vendor digest credentials (Course Services tab -> US / International PSTN vendor).
# Never commit the real values anywhere but the encrypted vault.yml.
vault_vendor_us_user: CHANGE_ME
vault_vendor_us_password: CHANGE_ME
vault_vendor_intl_user: CHANGE_ME
vault_vendor_intl_password: CHANGE_ME

# API (app nodes). JWT secret: identical on every app node, at least 16 chars:  openssl rand -hex 32
vault_jwt_secret: CHANGE_ME_to_openssl_rand_hex_32
# DID provider (DIDWW clone) Api-Key, Course Services tab.
vault_did_api_key: CHANGE_ME
# Payment gateway (Stripe clone) test-mode keys, Course Services tab. The publishable key is not
# secret (browsers get it) but comes from the same place.
vault_stripe_secret_key: CHANGE_ME
vault_stripe_publishable_key: CHANGE_ME
